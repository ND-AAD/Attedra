      "expect": {
        "properties": {
          "fire_rating": {
            "standing": "fulfilled",
            "fulfilled_by": "door-101|a601-0618|a-601",
            "qualifying_moment": "2026-06-18T11:00-07:00",
            "timeliness": "late",
            "late_by": "P2D"
          }
        }
      }
    }
  ]
}
