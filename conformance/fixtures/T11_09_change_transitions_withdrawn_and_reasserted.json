{
  "id": "T11_09_change_transitions_withdrawn_and_reasserted",
  "family": "T11",
  "rules": [
    "5.6.2",
    "6.7.4",
    "9.4.1"
  ],
  "description": "A source's withdrawn latest value is a 'withdrawn' transition between a frame before and a frame after the withdrawal, and its later Assertion is 'reasserted' between a frame after the withdrawal and one after the new Assertion.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "schedule"
        },
        {
          "id": "wd-1",
          "kind": "withdrawal"
        },
        {
          "id": "a601-issued-0601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "wd-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T09:00-07:00"
            }
          }
        },
        {
          "id": "a601-issued-0604",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-issued-0601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "a601-issued-0601",
            "source": "a-601",
            "property": "finish"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-issued-0604",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-101",
        "from": {
          "cutoff": "2026-06-01-07:00"
        },
        "to": {
          "cutoff": "2026-06-03-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "finish",
            "transition": "withdrawn",
            "prior": "door-101|a601-issued-0601|a-601"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-101",
        "from": {
          "cutoff": "2026-06-03-07:00"
        },
        "to": {
          "cutoff": "2026-06-05-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "finish",
            "transition": "reasserted",
            "new": "door-101|a601-issued-0604|a-601"
          }
        ]
      }
    }
  ]
}
