        "@outcome": "replace",
        "@corrected": {
          "finish": "stain"
        },
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ]
      },
      "expect_error": "10.2.5"
    },
    {
      "op": "assert",
      "item": "corr-x",
      "context": "corr-x-at",
      "source": "import-review-log",
      "values": {
        "@action": "correct",
        "@targets": [],
        "@outcome": "erroneous",
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ]
      },
      "expect_error": "10.2.5"
    },
    {
      "op": "assert",
      "item": "corr-x",
      "context": "corr-x-at",
      "source": "import-review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601"
          }
        ],
        "@outcome": "replace",
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ]
      },
      "expect_error": "10.2.5"
    },
    {
      "op": "assert",
      "item": "corr-x",
      "context": "corr-x-at",
      "source": "import-review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601"
          }
        ],
        "@outcome": "relocated",
        "@corrected": {
          "finish": "stain"
        },
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ]
      },
      "expect_error": "10.2.5"
    },
    {
      "op": "assert",
      "item": "corr-x",
      "context": "corr-x-at",
      "source": "import-review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-699"
          }
        ],
        "@outcome": "erroneous",
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ]
      },
      "expect_error": "10.2.2"
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "corr-x|corr-x-at|import-review-log"
