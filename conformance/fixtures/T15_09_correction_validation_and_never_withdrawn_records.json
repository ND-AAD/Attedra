{
  "id": "T15_09_correction_validation_and_never_withdrawn_records",
  "family": "T15",
  "rules": [
    "10.2.5",
    "10.2.2",
    "10.2.6",
    "6.7.9",
    "8.3.1",
    "8.3.4"
  ],
  "description": "A correction must target exactly one record (two targets and none are rejected under 10.2.5), a replace needs @corrected and a relocated needs an Assertion reference there (10.2.5), and its target must resolve (10.2.2). An erroneous correction needs no @corrected. Corrections and withdrawals are never withdrawn (10.2.6). Rejected writes leave the store unchanged.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "import-review-log",
          "kind": "process"
        },
        {
          "id": "door-102",
          "kind": "door"
        },
        {
          "id": "ev-mon-a601-102",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "corr-x",
          "kind": "correction"
        },
        {
          "id": "corr-x-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T10:00-07:00"
            }
          }
        },
        {
          "id": "corr-1",
          "kind": "correction"
        },
        {
          "id": "corr-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T11:00-07:00"
            }
          }
        },
        {
          "id": "wd-1",
          "kind": "withdrawal"
        },
        {
          "id": "wd-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T10:00-07:00"
            }
          }
        },
        {
          "id": "wd-x",
          "kind": "withdrawal"
        },
        {
          "id": "wd-x-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-102",
      "context": "ev-mon-a601-102",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "corr-x",
      "context": "corr-x-at",
      "source": "import-review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601"
          },
          {
