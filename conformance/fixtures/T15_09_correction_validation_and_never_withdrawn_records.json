            "item": "door-102",
            "context": "ev-mon-a601-102",
            "source": "a-601"
          }
        ],
        "@outcome": "erroneous",
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          }
        ],
        "@party": {
          "@ref": "item",
          "id": "owner"
        }
      }
    },
    {
      "op": "assert",
      "item": "wd-x",
      "context": "wd-x-at",
      "source": "wd-x",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "corr-1",
            "context": "corr-1-at",
            "source": "import-review-log"
          }
        ],
        "@party": {
          "@ref": "item",
          "id": "owner"
        }
      },
      "expect_error": "10.2.6"
    },
    {
      "op": "assert",
      "item": "wd-x",
      "context": "wd-x-at",
      "source": "wd-x",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "wd-1",
            "context": "wd-1-at",
            "source": "wd-1"
          }
        ],
        "@party": {
          "@ref": "item",
          "id": "owner"
        }
      },
      "expect_error": "10.2.6"
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "wd-x|wd-x-at|wd-x"
