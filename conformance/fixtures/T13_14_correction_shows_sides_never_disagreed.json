{
  "id": "T13_14_correction_shows_sides_never_disagreed",
  "family": "T13",
  "rules": [
    "7.2.6",
    "8.3.1",
    "8.3.2",
    "8.3.3",
    "8.4.1",
    "9.5.2",
    "I-16",
    "12.13"
  ],
  "description": "A-601's Monday finish was misrecorded as paint; a Wednesday replace correction shows it said stain. The story reads ended at every cutoff, including Tuesday (before the correction was made), with the correction as its ending record, and it never appears in open or pending reads. The detection keeps its recorded basis and the original keeps its content.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-09-91",
          "kind": "specification"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "architect",
          "kind": "party"
        },
        {
          "id": "story-1",
          "kind": "story"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "ev-mon-spec",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T11:00-07:00"
            }
          }
        },
        {
          "id": "story-1/d1",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T17:00-07:00"
            }
          }
        },
        {
          "id": "import-review-log",
          "kind": "process"
        },
        {
          "id": "corr-1",
          "kind": "correction"
        },
        {
          "id": "corr-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T10:30-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "story-1",
      "context": "story-1/d1",
      "source": "story-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "conflict",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          },
          "property": "finish"
        },
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-01T17:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "2026-06-02-07:00"
        }
      },
      "expect": {
        "standing": {
          "open": "open"
        }
      }
    },
    {
      "op": "assert",
      "item": "corr-1",
      "context": "corr-1-at",
      "source": "import-review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601"
          }
        ],
        "@outcome": "replace",
        "@corrected": {
          "finish": "stain"
        },
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ],
        "reason": "Finish misread during import."
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "ending": {
          "kind": "correction",
          "record": "corr-1|corr-1-at|import-review-log"
        },
        "standing": {
          "open": "ended",
          "disagreement": "aligned"
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "2026-06-02-07:00"
        }
      },
      "expect": {
        "ending": {
          "kind": "correction",
          "record": "corr-1|corr-1-at|import-review-log"
        },
        "standing": {
          "open": "ended"
        }
      }
    },
    {
      "op": "read",
      "read": "open_stories",
      "args": {
        "frame": {
          "cutoff": "2026-06-02-07:00"
        }
      },
      "expect": {
        "stories": [],
        "count": 0,
        "ambiguous": [],
        "limitations": [],
        "filter": null
      }
    },
    {
      "op": "read",
      "read": "pending_review",
      "args": {
        "frame": {
          "cutoff": "2026-06-02-07:00"
        }
      },
      "expect": {
        "stories": [],
        "count": 0
      }
    },
    {
      "op": "read",
      "read": "open_stories",
      "args": {
        "frame": {
          "cutoff": "2026-06-01T18:00-07:00"
        }
      },
      "expect": {
        "stories": [],
        "count": 0,
        "ambiguous": [],
        "limitations": [],
        "filter": null
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "story-1|story-1/d1|story-1"
      },
      "expect": {
        "status": "found",
        "values": {
          "@basis": [
            {
              "@ref": "assertion",
              "item": "door-101",
              "context": "ev-mon-a601",
              "source": "a-601",
              "property": "finish"
            },
            {
              "@ref": "assertion",
              "item": "door-101",
              "context": "ev-mon-spec",
              "source": "spec-09-91",
              "property": "finish"
            }
          ]
        }
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-mon-a601|a-601"
      },
      "expect": {
        "status": "found",
        "values": {
          "finish": "paint"
        },
        "corrections": [
          "corr-1|corr-1-at|import-review-log"
        ]
      }
    }
  ]
}
