{
  "id": "T15_21_reference_to_erroneous_original_has_no_effect",
  "family": "T15",
  "rules": [
    "8.3.7",
    "8.3.3",
    "2.4.1",
    "6.7.4",
    "5.6.1"
  ],
  "description": "A withdrawal targets A-601's Tuesday entry, leaving A-601 with no current finish. When the Tuesday entry is corrected as erroneous, the withdrawal keeps its exact reference but has no effect: A-601's Monday paint is current at every cutoff, and the withdrawal is not redirected to it.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "import-review-log",
          "kind": "process"
        },
        {
          "id": "corr-1",
          "kind": "correction"
        },
        {
          "id": "corr-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T10:00-07:00"
            }
          }
        },
        {
          "id": "wd-1",
          "kind": "withdrawal"
        },
        {
          "id": "wd-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "items",
      "items": [
        {
          "id": "ev-tue-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-tue-a601",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-tue-a601",
            "source": "a-601",
            "property": "finish"
          }
        ],
        "@party": {
          "@ref": "item",
          "id": "owner"
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-03-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "withdrawn",
            "withdrawn_by": "wd-1|wd-1-at|wd-1"
          }
        }
      }
    },
    {
      "op": "assert",
      "item": "corr-1",
      "context": "corr-1-at",
      "source": "import-review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-tue-a601",
            "source": "a-601"
          }
        ],
        "@outcome": "erroneous",
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-03-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|ev-mon-a601|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|ev-mon-a601|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "wd-1|wd-1-at|wd-1"
      },
      "expect": {
        "status": "found",
        "values": {
          "@targets": [
            {
              "@ref": "assertion",
              "item": "door-101",
              "context": "ev-tue-a601",
              "source": "a-601",
              "property": "finish"
            }
          ]
        }
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-mon-a601|a-601"
      },
      "expect": {
        "status": "found",
        "withdrawals": []
      }
    }
  ]
}
