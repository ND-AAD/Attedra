{
  "id": "T17_06_extension_members_in_definition_preserved",
  "family": "T17",
  "rules": [
    "10.4.1",
    "10.4.2",
    "8.1.5",
    "2.1.2",
    "4.1.1"
  ],
  "description": "Extension members and plain members in an Item definition are accepted and preserved; a context Item with an extension member beside @context still works as a context.",
  "steps": [
    {
      "op": "item",
      "id": "door-101",
      "kind": "door",
      "label": "Door 101",
      "definition": {
        "@x-catalog": {
          "family": "HM-1",
          "rev": 2
        },
        "type_code": "D1"
      }
    },
    {
      "op": "item",
      "id": "ev-1",
      "kind": "event",
      "definition": {
        "@context": {
          "role": "event",
          "at": "2026-05-14T09:45-07:00"
        },
        "@x-clock": "site"
      }
    },
    {
      "op": "items",
      "items": [
        {
          "id": "a-601",
          "kind": "door-schedule"
        }
      ]
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "door-101"
      },
      "expect": {
        "status": "found",
        "kind": "door",
        "label": "Door 101",
        "definition": {
          "@x-catalog": {
            "family": "HM-1",
            "rev": 2
          },
          "type_code": "D1"
        }
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "ev-1"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-05-14T09:45-07:00"
          },
          "@x-clock": "site"
        }
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-1",
      "source": "a-601",
      "values": {
        "finish": "paint"
      },
      "expect": {
        "status": "inserted"
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-05-14-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|ev-1|a-601"
          }
        }
      }
    }
  ]
}
