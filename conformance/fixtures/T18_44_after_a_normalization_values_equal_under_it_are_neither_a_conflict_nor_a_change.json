{
  "id": "T18_44_after_a_normalization_values_equal_under_it_are_neither_a_conflict_nor_a_change",
  "family": "T18",
  "rules": [
    "7.3.8",
    "5.5.4",
    "9.4.1",
    "9.4.2",
    "7.2.6",
    "7.2.7",
    "7.6.12",
    "9.5.2",
