            "item": "door-101",
            "context": "e-paint",
            "source": "a-601"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "ds",
      "context": "ds-at",
      "source": "ds",
      "values": {
        "@action": "establish",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "e-stain",
            "source": "a-601"
          }
        ],
        "@effective": "2026-06-05T09:00-07:00"
      }
    },
    {
      "op": "read",
      "read": "expectation",
      "args": {
        "ref": "door-101|e-stain|a-601",
        "frame": {
          "cutoff": "2026-06-03T12:00-07:00"
