      "expect": {
        "expectation_conflicts": [
          {
            "property": "finish",
            "sides": [
              {
                "expectation": "door-101|e-paint|a-601",
                "value": "paint"
              },
              {
                "expectation": "door-101|e-stain|a-601",
                "value": "stain"
              }
            ]
          }
        ]
