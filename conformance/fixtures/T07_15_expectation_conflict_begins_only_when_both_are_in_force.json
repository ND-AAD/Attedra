{
  "id": "T07_15_expectation_conflict_begins_only_when_both_are_in_force",
  "family": "T07",
  "rules": [
    "7.1.5",
    "6.3.1",
    "6.6.1",
    "8.4.1"
  ],
  "description": "The stain expectation's support is taken on 2 June with @effective 5 June. Before then the stain expectation is not in force and nothing conflicts; from 5 June the two required values conflict.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door",
          "label": "Door 101"
        },
        {
          "id": "a-601",
          "kind": "schedule",
          "label": "Door schedule A-601"
        },
        {
          "id": "e-paint",
          "kind": "expectation_context",
          "definition": {
            "@context": {
              "role": "expectation",
              "timing": {
                "type": "any"
              },
              "fresh": false
            }
          }
        },
        {
          "id": "e-stain",
          "kind": "expectation_context",
          "definition": {
            "@context": {
              "role": "expectation",
              "timing": {
                "type": "any"
              },
              "fresh": false
            }
          }
        },
        {
          "id": "dp",
          "kind": "decision"
        },
        {
          "id": "dp-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "ds",
          "kind": "decision"
        },
        {
          "id": "ds-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "e-paint",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "e-stain",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "dp",
      "context": "dp-at",
      "source": "dp",
      "values": {
