{
  "id": "T01_21_malformed_instants",
  "family": "T01",
  "rules": [
    "10.2.4",
    "4.2.1"
  ],
  "description": "An instant without an explicit UTC offset, at an unsupported precision or in another notation is rejected with 10.2.4, whether in @published, in @effective or in a Connection's creation time.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "arch-schedule",
          "kind": "milestone-schedule"
        },
        {
          "id": "arch-dd",
          "kind": "milestone",
          "definition": {
            "@context": {
              "role": "milestone",
              "schedule": {
                "@ref": "item",
                "id": "arch-schedule"
              },
              "stage": "100% DD",
              "ordinal": 300
            }
          }
        },
        {
          "id": "issue-log",
          "kind": "log"
        },
        {
          "id": "contractor",
          "kind": "party"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "ev-0514",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45-07:00"
            }
          }
        },
        {
          "id": "wd-1",
          "kind": "withdrawal"
        },
        {
          "id": "wd-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T10:00-07:00"
            }
          }
        },
        {
          "id": "room-12",
          "kind": "room"
        }
      ]
    },
    {
      "op": "assert",
      "item": "arch-dd",
      "context": "arch-dd",
      "source": "issue-log",
      "values": {
        "@published": "2026-05-13 11:45",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      },
      "expect_error": "10.2.4"
    },
    {
      "op": "assert",
      "item": "arch-dd",
      "context": "arch-dd",
      "source": "issue-log",
      "values": {
        "@published": "2026-05-13T11:45:12",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      },
      "expect_error": "10.2.4"
    },
    {
      "op": "assert",
      "item": "arch-dd",
      "context": "arch-dd",
      "source": "issue-log",
      "values": {
        "@published": "2026-05-13",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      },
      "expect_error": "10.2.4"
    },
    {
      "op": "assert",
      "item": "arch-dd",
      "context": "arch-dd",
      "source": "issue-log",
      "values": {
        "@published": "2026-05-13T11-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      },
      "expect_error": "10.2.4"
    },
    {
      "op": "assert",
      "item": "arch-dd",
      "context": "arch-dd",
      "source": "issue-log",
      "values": {
        "@published": "13/05/2026",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      },
      "expect_error": "10.2.4"
    },
    {
      "op": "assert",
      "item": "arch-dd",
      "context": "arch-dd",
      "source": "issue-log",
      "values": {
        "@published": "2026-5-13-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      },
      "expect_error": "10.2.4"
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "arch-dd|arch-dd|issue-log"
      },
      "expect": {
        "status": "not_found"
      }
    },
    {
      "op": "assert",
      "item": "arch-dd",
      "context": "arch-dd",
      "source": "issue-log",
      "values": {
        "@published": "2026-05-13T11:45:12-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      },
      "expect": {
        "status": "inserted"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0514",
            "source": "a-601"
          }
        ],
        "@effective": "2026-06-05"
      },
      "expect_error": "10.2.4"
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0514",
            "source": "a-601"
          }
        ],
        "@effective": "2026-06-05T09:00"
      },
      "expect_error": "10.2.4"
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0514",
            "source": "a-601"
          }
        ],
        "@effective": "2026-06-05-07:00"
      },
      "expect": {
        "status": "inserted"
      }
    },
    {
      "op": "connect",
      "from": "room-12",
      "to": "door-101",
      "at": "2026-05-11 09:00",
      "expect_error": "10.2.4"
    },
    {
      "op": "read",
      "read": "adjacency",
      "args": {
        "item": "room-12",
        "frame": {
          "cutoff": "2026-05-20-07:00"
        }
      },
      "expect": {
        "outgoing": [],
        "incoming": []
      }
    },
    {
      "op": "connect",
      "from": "room-12",
      "to": "door-101",
      "at": "2026-05-11T09:00-07:00",
      "expect": {
        "status": "created"
      }
    }
  ]
}
