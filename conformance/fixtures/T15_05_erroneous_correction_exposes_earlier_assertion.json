{
  "id": "T15_05_erroneous_correction_exposes_earlier_assertion",
  "family": "T15",
  "rules": [
    "8.3.1",
    "8.3.3",
    "8.3.2",
    "9.2.1",
    "I-16"
  ],
  "description": "A Wednesday entry that no communication supports is corrected as erroneous on Thursday. It contributes nothing at any frame: A-601's Monday value is current at Wednesday and now, while the exact read still returns the entry together with its correction.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "import-review-log",
          "kind": "process"
        },
        {
          "id": "corr-1",
          "kind": "correction"
        },
        {
          "id": "corr-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "items",
      "items": [
        {
          "id": "ev-wed-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-wed-a601",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-03-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "stain",
            "origin": "door-101|ev-wed-a601|a-601"
          }
        }
      }
    },
    {
      "op": "assert",
      "item": "corr-1",
      "context": "corr-1-at",
      "source": "import-review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-wed-a601",
            "source": "a-601"
          }
        ],
        "@outcome": "erroneous",
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ],
        "reason": "Duplicate import."
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-03-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|ev-mon-a601|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|ev-mon-a601|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-wed-a601|a-601"
      },
      "expect": {
        "status": "found",
        "values": {
          "finish": "stain"
        },
        "corrections": [
          "corr-1|corr-1-at|import-review-log"
        ]
      }
    }
  ]
}
