{
  "id": "T01_11_unresolved_assertion_reference",
  "family": "T01",
  "rules": [
    "10.2.2",
    "2.4.1",
    "2.4.3"
  ],
  "description": "An Assertion reference that does not resolve to a recorded triple is rejected with 10.2.2, in values, in @targets (with or without a property selector) and in @basis; once the triple exists the same write succeeds.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-0991",
          "kind": "specification"
        },
        {
          "id": "ev-0514",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45-07:00"
            }
          }
        },
        {
          "id": "ev-0515",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-15T09:45-07:00"
            }
          }
        },
        {
          "id": "wd-1",
          "kind": "withdrawal"
        },
        {
          "id": "wd-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0515",
      "source": "a-601",
      "values": {
        "finish": "stain",
        "compare_with": {
          "@ref": "assertion",
          "item": "door-101",
          "context": "ev-0514",
          "source": "spec-0991"
        }
      },
      "expect_error": "10.2.2"
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0515",
            "source": "a-601"
          }
        ]
      },
      "expect_error": "10.2.2"
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0515",
            "source": "a-601",
            "property": "finish"
          }
        ]
      },
      "expect_error": "10.2.2"
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0514",
            "source": "a-601"
          }
        ],
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0514",
            "source": "spec-0991"
          }
        ]
      },
      "expect_error": "10.2.2"
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "wd-1|wd-1-at|wd-1"
      },
      "expect": {
        "status": "not_found"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-0515|a-601"
      },
      "expect": {
        "status": "not_found"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0515",
      "source": "a-601",
      "values": {
        "finish": "stain"
      },
      "expect": {
        "status": "inserted"
      }
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0515",
            "source": "a-601",
            "property": "finish"
          }
        ]
      },
      "expect": {
        "status": "inserted"
      }
    }
  ]
}
