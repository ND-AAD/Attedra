{
  "id": "T15_10_duplicate_without_dependents_removed_and_triple_freed",
  "family": "T15",
  "rules": [
    "8.5.1",
    "8.5.3",
    "8.5.4",
    "8.5.5",
    "8.5.6",
    "9.2.1",
    "I-8",
    "12.15"
  ],
  "description": "A duplicate import of A-601's Monday statement at a second event context has no dependents. The plan returns an identifier, the confirm removes it, and nothing remains: the exact read returns not_found, the by-source read no longer lists it, its context Item survives, and the freed triple can be written again.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "ev-mon-a601-dup",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601-dup",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-mon-a601-dup|a-601"
      },
      "expect": {
        "status": "found",
        "dependents": []
      }
    },
    {
      "op": "plan_removal",
      "target": "door-101|ev-mon-a601-dup|a-601",
      "as": "p1",
      "expect": {
        "status": "planned",
        "plan": "~any"
      }
    },
    {
      "op": "confirm_removal",
      "plan": "$p1",
      "expect": {
        "status": "removed"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-mon-a601-dup|a-601"
      },
      "expect": {
        "status": "not_found"
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "ev-mon-a601-dup"
      },
      "expect": {
        "status": "found"
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-02-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|ev-mon-a601|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "by_party",
      "args": {
        "frame": {
          "cutoff": "now"
        },
        "source": "a-601"
      },
      "expect": {
        "statements": [
          "door-101|ev-mon-a601|a-601"
        ],
        "acts": []
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601-dup",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-mon-a601-dup|a-601"
      },
      "expect": {
        "status": "found",
        "values": {
          "finish": "paint"
        }
      }
    }
  ]
}
