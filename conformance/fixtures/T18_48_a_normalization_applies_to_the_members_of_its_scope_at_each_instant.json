{
  "id": "T18_48_a_normalization_applies_to_the_members_of_its_scope_at_each_instant",
  "family": "T18",
  "rules": [
    "7.3.8",
    "2.1.5",
    "4.6.1",
    "7.2.8",
    "7.6.4",
    "7.6.9",
    "8.6.4",
    "9.10.1"
