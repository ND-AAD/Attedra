{
  "id": "T05_07_backfilled_older_assertion_does_not_revive_after_withdrawal",
  "family": "T05",
  "rules": [
    "5.2.1",
    "6.7.4",
    "4.2.3",
    "I-5"
  ],
  "description": "A-601's 3 June fire_rating 90 is withdrawn, and A-601's 1 June fire_rating 60 is then imported late. After the withdrawal the property still reads withdrawn, because the backfilled Assertion is older by occurrence time. A 2 June frame reads the backfilled 60.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door",
          "label": "Door 101"
        },
        {
          "id": "a-601",
          "kind": "schedule",
          "label": "Door schedule A-601"
        },
        {
          "id": "a601-0603",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T09:00-07:00"
            }
          }
        },
        {
          "id": "w1",
          "kind": "withdrawal"
        },
        {
          "id": "w1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-05T09:00-07:00"
            }
          }
        },
        {
          "id": "a601-0601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-0603",
      "source": "a-601",
      "values": {
        "fire_rating": 90
      }
    },
    {
      "op": "assert",
      "item": "w1",
      "context": "w1-at",
      "source": "w1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "a601-0603",
            "source": "a-601"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-0601",
      "source": "a-601",
      "values": {
        "fire_rating": 60
      },
      "recorded_at": "2026-06-07T09:00:00-07:00"
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-06T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "fire_rating": {
            "classification": "withdrawn",
            "withdrawn_by": "w1|w1-at|w1",
            "value": "~absent",
            "origin": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-02T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "fire_rating": {
            "classification": "asserted",
            "value": 60,
            "origin": "door-101|a601-0601|a-601",
            "withdrawn_by": "~absent"
          }
        }
      }
    }
  ]
}
