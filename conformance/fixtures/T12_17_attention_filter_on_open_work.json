        {
          "id": "ign-2",
          "kind": "ignore"
        },
        {
          "id": "ign-2-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T11:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "e-fin",
