      "read": "open_work",
      "args": {
        "frame": {
          "cutoff": "2026-06-06-07:00"
        },
        "attention_filter": "ignore"
      },
      "expect": {
        "open": [
          {
            "expectation": "door-102|e-fin|a-601",
            "outstanding": [
              "finish"
            ]
          }
