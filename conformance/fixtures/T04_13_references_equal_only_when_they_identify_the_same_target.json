{
  "id": "T04_13_references_equal_only_when_they_identify_the_same_target",
  "family": "T04",
  "rules": [
    "5.5.1",
    "2.4.3",
    "8.1.2",
    "8.1.3",
    "6.7.2"
  ],
  "description": "References are equal only when they identify the same target: the same Item, the same Assertion with the same selectors, the same Connection, or the same artifact at the same edition. A reference with a property selector never equals one without, and an artifact at another edition is a different value. Re-writing a withdrawal with its target narrowed by a selector is changed content and fails occupied; the identical withdrawal replays.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "door-102",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-0991",
          "kind": "specification"
        },
        {
          "id": "room-12",
          "kind": "room"
        },
        {
          "id": "ev-0513",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-13T09:45-07:00"
            }
          }
        },
        {
          "id": "ev-0514",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45-07:00"
            }
          }
        },
        {
          "id": "wd-1",
          "kind": "withdrawal"
        },
        {
          "id": "wd-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "room-12",
      "to": "door-101",
      "at": "2026-05-11T09:00-07:00"
    },
    {
      "op": "assert",
      "item": "door-102",
      "context": "ev-0513",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "a-601",
      "values": {
        "cites_same": {
          "@ref": "assertion",
          "item": "door-102",
          "context": "ev-0513",
          "source": "a-601"
        },
        "cites_sel": {
          "@ref": "assertion",
          "item": "door-102",
          "context": "ev-0513",
          "source": "a-601"
        },
        "drawing_same": {
          "@ref": "artifact",
          "id": "a-601-rev-3.pdf",
          "edition": "rev 3"
        },
        "drawing_ed": {
          "@ref": "artifact",
          "id": "a-601-rev-3.pdf",
          "edition": "rev 3"
        },
        "hung_in": {
          "@ref": "connection",
          "from": "room-12",
          "to": "door-101"
        },
        "room": {
          "@ref": "item",
          "id": "room-12"
        }
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "spec-0991",
      "values": {
        "cites_same": {
          "@ref": "assertion",
          "item": "door-102",
          "context": "ev-0513",
          "source": "a-601"
        },
        "cites_sel": {
          "@ref": "assertion",
          "item": "door-102",
          "context": "ev-0513",
          "source": "a-601",
          "property": "finish"
        },
        "drawing_same": {
          "@ref": "artifact",
          "id": "a-601-rev-3.pdf",
          "edition": "rev 3"
        },
        "drawing_ed": {
          "@ref": "artifact",
          "id": "a-601-rev-3.pdf",
          "edition": "rev 4"
        },
        "hung_in": {
          "@ref": "connection",
          "from": "room-12",
          "to": "door-101"
        },
        "room": {
          "@ref": "item",
          "id": "room-12"
        }
      }
    },
    {
      "op": "read",
      "read": "conflicts",
      "args": {
        "subject": "door-101",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "conflicts": [
          {
            "property": "cites_sel",
            "sides": [
              {
                "source": "a-601",
                "origin": "door-101|ev-0514|a-601"
              },
              {
                "source": "spec-0991",
                "origin": "door-101|ev-0514|spec-0991"
              }
            ]
          },
          {
            "property": "drawing_ed",
            "sides": [
              {
                "source": "a-601",
                "value": {
                  "@ref": "artifact",
                  "id": "a-601-rev-3.pdf",
                  "edition": "rev 3"
                }
              },
              {
                "source": "spec-0991",
                "value": {
                  "@ref": "artifact",
                  "id": "a-601-rev-3.pdf",
                  "edition": "rev 4"
                }
              }
            ]
          }
        ],
        "interpretation": null
      }
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-102",
            "context": "ev-0513",
            "source": "a-601"
          }
        ]
      },
      "expect": {
        "status": "inserted"
      }
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-102",
            "context": "ev-0513",
            "source": "a-601",
            "property": "finish"
          }
        ]
      },
      "expect_error": "occupied"
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-102",
            "context": "ev-0513",
            "source": "a-601"
          }
        ]
      },
      "expect": {
        "status": "replayed"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "wd-1|wd-1-at|wd-1"
      },
      "expect": {
        "status": "found",
        "values": {
          "@targets": [
            {
              "@ref": "assertion",
              "item": "door-102",
              "context": "ev-0513",
              "source": "a-601"
            }
          ]
        }
      }
    }
  ]
}
