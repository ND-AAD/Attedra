    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-102",
        "source": "a-601",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "lacquer",
            "origin": "door-102|m-120|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-102",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-05-07:00"
