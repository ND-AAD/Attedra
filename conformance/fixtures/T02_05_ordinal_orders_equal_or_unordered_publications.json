{
  "id": "T02_05_ordinal_orders_equal_or_unordered_publications",
  "family": "T02",
  "rules": [
    "5.2.1",
    "4.3.2",
    "4.5.2",
    "4.2.5"
  ],
  "description": "Within one schedule, Assertions at milestones whose publication instants are equal or unordered are ordered by ordinal, whatever the order in which they were written.",
