              },
              "stage": "Bulletin 1",
              "ordinal": 110
            }
          }
        },
        {
          "id": "m-120",
          "kind": "milestone",
          "definition": {
            "@context": {
              "role": "milestone",
              "schedule": {
                "@ref": "item",
                "id": "arch-schedule"
              },
              "stage": "Bulletin 2",
              "ordinal": 120
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "m-50",
