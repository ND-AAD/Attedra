        "@published": "2026-06-02T10:00-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "m-110",
      "context": "m-110",
      "source": "issue-log",
      "values": {
        "@published": "2026-06-09-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
