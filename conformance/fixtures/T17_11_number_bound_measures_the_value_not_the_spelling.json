{
  "id": "T17_11_number_bound_measures_the_value_not_the_spelling",
  "family": "T17",
  "rules": [
    "5.1.2",
    "5.1.3",
    "5.5.1",
    "10.2.4"
  ],
  "description": "The 5.1.2 bound measures a number's value: the coefficient is taken without leading or trailing zeros. 1 written with 37 trailing fractional zeros, 1 followed by forty zeros, and a 34-digit coefficient followed by zeros are valid; zero is valid whatever its exponent; 12345E-1003 has exponent -999 and is valid. 12345E+996 (exponent 1000) and 12345E-1004 (exponent -1000) fail number_out_of_range. Two spellings of one value are valid together and compare equal.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-0991",
          "kind": "specification"
        },
        {
          "id": "ev-0514",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "a-601",
      "values_json": "{\"one_padded\": 1.0000000000000000000000000000000000000, \"big_spelled\": 10000000000000000000000000000000000000000, \"trailing_34\": 1234567890123456789012345678901234000, \"zero_exp\": 0E+5000, \"tiny_edge\": 12345E-1003, \"same\": 1.50}",
      "expect": {
        "status": "inserted"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "spec-0991",
      "values_json": "{\"same\": 15E-1, \"big\": 12345E+996}",
      "expect_error": "number_out_of_range"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "spec-0991",
      "values_json": "{\"same\": 15E-1, \"tiny\": 12345E-1004}",
      "expect_error": "number_out_of_range"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "spec-0991",
      "values_json": "{\"same\": 15E-1, \"one_padded\": 1, \"big_spelled\": 1E+40}",
      "expect": {
        "status": "inserted"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-0514|a-601"
      },
      "expect": {
        "status": "found",
        "values": {
          "one_padded": 1,
          "big_spelled": 1E+40,
          "trailing_34": 1234567890123456789012345678901234000,
          "zero_exp": 0,
          "tiny_edge": 1.2345E-999,
          "same": 1.5
        }
      }
    },
    {
      "op": "read",
      "read": "conflicts",
      "args": {
        "subject": "door-101",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "conflicts": [],
        "interpretation": null
      }
    }
  ]
}
