{
  "id": "T09_27_instants_in_results_are_returned_as_written",
  "family": "T09",
  "rules": [
    "4.2.1",
    "5.1.3",
    "9.3.1",
    "9.2.4",
    "4.6.1"
  ],
  "description": "Instants in results are returned as written in the record or argument that supplies them, at the same precision and offset, never normalized: the frame's cutoff echoes a +05:30 argument, the qualifying moment is the evidence's second-precision +02:00 instant, the deadline is the context's date, and by-source details carry the occurrence as written.",
