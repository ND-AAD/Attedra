{
  "id": "T10_01_cross_schedule_milestones_ordered_by_publication_instant",
  "family": "T10",
  "rules": [
    "4.3.1",
    "4.3.3",
    "4.2.4",
    "5.2.1",
    "4.6.1",
    "12.10"
  ],
  "description": "A drawing published in the consultant's 50% CD (ordinal 500, Tuesday) and the architect's 100% DD (ordinal 300, Wednesday) is ordered by publication instant, not by ordinal, across schedules. A milestone cutoff resolves to that milestone's publication instant.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "consultant",
          "kind": "party"
        },
        {
          "id": "architect",
          "kind": "party"
        },
        {
          "id": "cons-schedule",
          "kind": "schedule"
        },
        {
          "id": "arch-schedule",
          "kind": "schedule"
        },
        {
          "id": "cons-log",
          "kind": "issue-log"
        },
        {
          "id": "arch-log",
          "kind": "issue-log"
        },
        {
          "id": "coord-plan",
          "kind": "coordination-drawing"
        }
      ]
    },
    {
      "op": "items",
      "items": [
        {
          "id": "cons-50cd",
          "kind": "milestone",
          "definition": {
            "@context": {
              "role": "milestone",
              "schedule": {
                "@ref": "item",
                "id": "cons-schedule"
              },
              "stage": "50% CD",
              "ordinal": 500
            }
          }
        },
        {
          "id": "arch-100dd",
          "kind": "milestone",
          "definition": {
            "@context": {
              "role": "milestone",
              "schedule": {
                "@ref": "item",
                "id": "arch-schedule"
              },
              "stage": "100% DD",
              "ordinal": 300
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "arch-100dd",
      "context": "arch-100dd",
      "source": "arch-log",
      "values": {
        "@published": "2026-05-13T11:45:12-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "consultant"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "arch-100dd",
      "source": "coord-plan",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "cons-50cd",
      "context": "cons-50cd",
      "source": "cons-log",
      "values": {
        "@published": "2026-05-12T15:00-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "architect"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "cons-50cd",
      "source": "coord-plan",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "coord-plan",
        "frame": {}
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "stain",
            "origin": "door-101|arch-100dd|coord-plan"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "coord-plan",
        "frame": {
          "cutoff": "cons-50cd"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|cons-50cd|coord-plan"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "coord-plan",
        "frame": {
          "cutoff": "2026-05-13T09:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|cons-50cd|coord-plan"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "coord-plan",
        "frame": {
          "cutoff": "arch-100dd"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "stain",
            "origin": "door-101|arch-100dd|coord-plan"
          }
        }
      }
    }
  ]
}
