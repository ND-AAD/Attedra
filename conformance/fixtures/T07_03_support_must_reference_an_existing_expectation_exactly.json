{
  "id": "T07_03_support_must_reference_an_existing_expectation_exactly",
  "family": "T07",
  "rules": [
    "6.3.1",
    "2.4.1",
    "10.2.2"
  ],
  "description": "An establish act whose target expectation was never written is rejected (10.2.2), and so is one whose @targets is not a list (10.2.2). Neither changes the store. Once the expectation exists, the same act succeeds and brings it into force.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door",
          "label": "Door 101"
        },
        {
          "id": "a-601",
          "kind": "schedule",
          "label": "Door schedule A-601"
        },
        {
          "id": "e1",
          "kind": "expectation_context",
          "definition": {
            "@context": {
              "role": "expectation",
              "timing": {
                "type": "by",
                "instant": "2026-06-30-07:00"
              },
              "fresh": false
            }
          }
        },
        {
          "id": "d1",
          "kind": "decision"
        },
        {
          "id": "d1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "d1",
      "context": "d1-at",
      "source": "d1",
      "values": {
        "@action": "establish",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "e1",
            "source": "a-601"
          }
        ]
      },
      "expect_error": "10.2.2"
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "d1|d1-at|d1"
      },
      "expect": {
        "status": "not_found"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "e1",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "d1",
      "context": "d1-at",
      "source": "d1",
      "values": {
        "@action": "establish",
        "@targets": {
          "@ref": "assertion",
          "item": "door-101",
          "context": "e1",
          "source": "a-601"
        }
      },
      "expect_error": "10.2.2"
    },
    {
      "op": "read",
      "read": "expectation",
      "args": {
        "ref": "door-101|e1|a-601",
        "frame": {
          "cutoff": "2026-06-01T12:00-07:00"
        }
      },
      "expect": {
        "in_force": false,
        "properties": {
          "finish": {
            "standing": "not_in_force"
          }
        }
      }
    },
    {
      "op": "assert",
      "item": "d1",
      "context": "d1-at",
      "source": "d1",
      "values": {
        "@action": "establish",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "e1",
            "source": "a-601"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "expectation",
      "args": {
        "ref": "door-101|e1|a-601",
        "frame": {
          "cutoff": "2026-06-01T12:00-07:00"
        }
      },
      "expect": {
        "in_force": true,
        "supports": [
          {
            "support": "d1|d1-at|d1",
            "covers": [
              "finish"
            ],
            "withdrawn_by": []
          }
        ],
        "properties": {
          "finish": {
            "standing": "outstanding",
            "overdue": false
          }
        }
      }
    }
  ],
  "note": "9.3.1: the expectation read returns \"its supports, meaning every support whose occurrence time is at or before the cutoff, each with the properties it covers at the cutoff and, for coverage that has ended or never began, the withdrawals that ended it (6.3.3, 6.7.2)\". README section 5 gives each as {\"support\", \"covers\", \"withdrawn_by\"}. Step 8: `supports` lists <support> objects; every support listed covers all of the expectation's properties at that cutoff and none was withdrawn, and no other support occurred by then."
}
