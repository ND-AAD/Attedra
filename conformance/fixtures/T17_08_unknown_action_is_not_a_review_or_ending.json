{
  "id": "T17_08_unknown_action_is_not_a_review_or_ending",
  "family": "T17",
  "rules": [
    "10.4.2",
    "7.2.7",
    "7.4.1",
    "9.5.1",
    "9.5.2",
    "9.5.3",
    "9.5.4"
  ],
  "description": "A record with an undefined @action that targets a change story is not a review: the story stays open, unreviewed and pending review, and lists no act.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "ev-mon",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T10:00-07:00"
            }
          }
        },
        {
          "id": "ev-thu",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T10:00-07:00"
            }
          }
        },
        {
          "id": "story-1",
          "kind": "story"
        },
        {
          "id": "story-1/d1",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T16:00-07:00"
            }
          }
        },
        {
          "id": "esc-1",
          "kind": "escalation"
        },
        {
          "id": "esc-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-05T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-thu",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "story-1",
      "context": "story-1/d1",
      "source": "story-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "change",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          }
        },
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-thu",
            "source": "a-601",
            "property": "finish"
          }
        ],
        "@transitions": [
          {
            "property": "finish",
            "transition": "changed",
            "prior": {
              "@ref": "assertion",
              "item": "door-101",
              "context": "ev-mon",
              "source": "a-601"
            },
            "new": {
              "@ref": "assertion",
              "item": "door-101",
              "context": "ev-thu",
              "source": "a-601"
            }
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-04T15:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "assert",
      "item": "esc-1",
      "context": "esc-1-at",
      "source": "esc-1",
      "values": {
        "@action": "approve-change",
        "@targets": [
          {
            "@ref": "item",
            "id": "story-1"
          }
        ],
        "@basis": [
          {
            "@ref": "assertion",
            "item": "story-1",
            "context": "story-1/d1",
            "source": "story-1"
          }
        ],
        "verdict": "approved"
      },
      "expect": {
        "status": "inserted"
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "kind": "change",
        "detections": [
          "story-1|story-1/d1|story-1"
        ],
        "acts": [],
        "ending": null,
        "standing": {
          "open": "open",
          "review": "unreviewed",
          "disagreement": "~absent"
        }
      }
    },
    {
      "op": "read",
      "read": "open_stories",
      "args": {
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "stories": [
          "story-1"
        ],
        "count": 1
      }
    },
    {
      "op": "read",
      "read": "pending_review",
      "args": {
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "stories": [
          "story-1"
        ],
        "count": 1
      }
    }
  ]
}
