          "id": "architect"
        },
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-issued-0514",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "a-601",
      "context": "dist-0520",
      "source": "transmittal-22",
      "values": {
        "@distribution": [
          {
            "@ref": "item",
            "id": "consultant-mep"
          }
        ],
        "@issuance": {
          "@ref": "item",
          "id": "a601-issued-0514"
        }
      }
    },
    {
      "op": "read",
      "read": "distribution",
      "args": {
        "item": "a-601"
      },
      "expect": {
        "distributions": [
          {
            "record": "a-601|a601-issued-0514|a-601",
            "at": "2026-05-14T09:00-07:00",
            "issuance": "a601-issued-0514",
            "recipients": [
              "contractor"
            ]
          },
          {
            "record": "a-601|dist-0520|transmittal-22",
            "at": "2026-05-20T10:00-07:00",
            "issuance": "a601-issued-0514",
            "recipients": [
              "consultant-mep"
            ]
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-05-18-07:00",
          "perspective": "consultant-mep"
        },
        "properties": [
          "finish"
        ]
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "never_asserted",
            "value": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-05-21-07:00",
          "perspective": "consultant-mep"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "stain",
            "origin": "door-101|a601-issued-0514|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "a-601",
        "source": "transmittal-22",
        "frame": {}
      },
      "expect": {
        "properties": {
          "@distribution": "~absent",
          "@issuance": "~absent"
        }
      }
    }
  ]
