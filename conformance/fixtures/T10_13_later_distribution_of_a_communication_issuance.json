{
  "id": "T10_13_later_distribution_of_a_communication_issuance",
  "family": "T10",
  "rules": [
    "4.4.1",
    "4.4.2",
    "9.7.1",
    "2.4.7"
  ],
  "description": "A transmittal redistributes A-601's 14 May issuance (named in @issuance) to the MEP consultant on 20 May. The distribution history lists both dated distributions of that issuance; the consultant is covered from 20 May; the distribution's reserved members are not properties.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "architect",
          "kind": "party"
        },
        {
          "id": "contractor",
          "kind": "party"
        },
        {
          "id": "consultant-mep",
          "kind": "party"
        },
        {
          "id": "a-601",
          "kind": "schedule"
        },
        {
          "id": "transmittal-22",
          "kind": "transmittal"
        },
        {
          "id": "a601-issued-0514",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:00-07:00"
            }
          }
        },
        {
          "id": "dist-0520",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-20T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "a-601",
      "context": "a601-issued-0514",
      "source": "a-601",
      "values": {
