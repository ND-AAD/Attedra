{
  "id": "T18_52_evidence_at_an_unpublished_milestone_records_no_ending_until_the_milestone_is_published",
  "family": "T18",
  "rules": [
    "6.5.5",
    "7.6.6",
    "4.2.4",
    "6.2.1",
    "6.5.4",
