            "new": "door-101|ev-cd|a-601",
            "members": []
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-102",
        "from": {
          "cutoff": "2026-06-01-07:00"
        },
        "to": {
          "cutoff": "2026-06-30-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "hardware_set",
            "transition": "changed",
            "prior": "door-102|ev-dd|a-601",
            "new": "door-102|ev-cd|a-601",
            "members": [
              {
                "member": "hinges",
                "difference": "member_changed"
              }
            ]
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-103",
        "from": {
          "cutoff": "2026-06-01-07:00"
        },
        "to": {
          "cutoff": "2026-06-30-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "finish",
            "transition": "changed",
            "prior": "door-103|ev-dd|a-601",
            "new": "door-103|ev-cd|a-601",
            "members": []
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-104",
        "from": {
          "cutoff": "2026-06-01-07:00"
        },
        "to": {
          "cutoff": "2026-06-30-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "location",
            "transition": "changed",
            "prior": "door-104|ev-dd|a-601",
            "new": "door-104|ev-cd|a-601",
            "members": []
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-105",
        "from": {
          "cutoff": "2026-06-01-07:00"
        },
        "to": {
          "cutoff": "2026-06-30-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "dimensions",
            "transition": "unchanged",
            "prior": "door-105|ev-dd|a-601",
            "new": "door-105|ev-cd|a-601",
            "members": []
          }
        ]
      }
    }
  ]
}
