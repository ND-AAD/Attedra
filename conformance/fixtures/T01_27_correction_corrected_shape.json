      "op": "assert",
      "item": "cor-2",
      "context": "cor-2-at",
      "source": "review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0514",
            "source": "a-601"
          }
        ],
        "@outcome": "relocated",
        "@corrected": [
          {
            "@ref": "assertion",
            "item": "door-102",
            "context": "ev-0514",
            "source": "a-601"
          }
        ]
      },
      "expect_error": "10.2.5"
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "cor-1|cor-1-at|review-log"
