    {
      "op": "assert",
      "item": "cor-2",
      "context": "cor-2-at",
      "source": "review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-0514",
            "source": "a-601"
