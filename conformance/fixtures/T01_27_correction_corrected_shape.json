          "kind": "log"
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-102",
      "context": "ev-0514",
      "source": "a-601",
      "values": {
        "finish": "paint"
