{
  "id": "T01_27_correction_corrected_shape",
  "family": "T01",
  "rules": [
    "10.2.5",
    "8.3.1"
  ],
  "description": "A replace correction without @corrected, and a relocated correction whose @corrected is not one Assertion reference, are rejected with 10.2.5; well-formed replace and relocated corrections are accepted.",
