{
  "id": "T01_06_create_existing_disconnected_pair_is_noop",
  "family": "T01",
  "rules": [
    "2.2.1",
    "8.6.1",
    "8.6.2",
    "8.6.3",
    "8.6.4"
  ],
  "description": "Creating a Connection for a pair that already has a disconnected Connection is a successful no-op and does not reconnect it.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "room-12",
          "kind": "room"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "disc-1",
          "kind": "disconnection"
        },
        {
          "id": "disc-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-12T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "room-12",
      "to": "door-101",
      "at": "2026-05-11T09:00-07:00",
      "expect": {
        "status": "created"
      }
    },
    {
      "op": "assert",
      "item": "disc-1",
      "context": "disc-1-at",
      "source": "disc-1",
      "values": {
        "@action": "disconnect",
        "@targets": [
          {
            "@ref": "connection",
            "from": "room-12",
            "to": "door-101"
          }
        ],
        "reason": "Door relocated"
      }
    },
    {
      "op": "connect",
      "from": "room-12",
      "to": "door-101",
      "at": "2026-05-13T09:00-07:00",
      "expect": {
        "status": "exists"
      }
    },
    {
      "op": "read",
      "read": "adjacency",
      "args": {
        "item": "room-12",
        "frame": {
          "cutoff": "2026-05-14-07:00"
        }
      },
      "expect": {
        "outgoing": [],
        "incoming": []
      }
    },
    {
      "op": "read",
      "read": "adjacency",
      "args": {
        "item": "door-101",
        "frame": {
          "cutoff": "2026-05-14-07:00"
        }
      },
      "expect": {
        "outgoing": [],
        "incoming": []
      }
    },
    {
      "op": "read",
      "read": "adjacency",
      "args": {
        "item": "room-12",
        "frame": {
          "cutoff": "2026-05-11T12:00-07:00"
        }
      },
      "expect": {
        "outgoing": [
          "door-101"
        ],
        "incoming": []
      }
    }
  ]
}
