{
  "id": "T10_23_distribution_read_takes_a_frame",
  "family": "T10",
  "rules": [
    "9.7.1",
    "9.7.2",
    "4.4.1",
    "4.4.2",
    "4.5.3",
    "4.6.1"
  ],
  "description": "The distribution read lists the dated distributions whose occurrence is at or before the cutoff, with the issuance each distributed (the milestone, for a publication and its later distribution) and the recipients in recorded order. A distribution whose relation to the cutoff is unspecified is listed under ambiguous. In a participant perspective only the distribution records covered for that participant are listed.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "architect",
          "kind": "party"
        },
        {
          "id": "contractor",
          "kind": "party"
        },
        {
          "id": "consultant",
          "kind": "party"
        },
        {
          "id": "client",
          "kind": "party"
        },
        {
          "id": "arch-schedule",
          "kind": "schedule"
        },
        {
          "id": "arch-log",
          "kind": "issue-log"
        },
        {
          "id": "a-601",
          "kind": "schedule"
        },
        {
          "id": "arch-100dd",
          "kind": "milestone",
          "definition": {
            "@context": {
              "role": "milestone",
              "schedule": {
                "@ref": "item",
                "id": "arch-schedule"
              },
              "stage": "100% DD",
              "ordinal": 300
            }
          }
        },
        {
          "id": "dist-0515",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-15-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "arch-100dd",
      "context": "arch-100dd",
      "source": "arch-log",
      "values": {
        "@published": "2026-05-13T11:45:12-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          },
          {
            "@ref": "item",
            "id": "architect"
          }
        ],
        "edition": "set 4"
      }
    },
    {
      "op": "assert",
      "item": "arch-100dd",
      "context": "dist-0515",
      "source": "arch-log",
      "values": {
        "@distribution": [
          {
            "@ref": "item",
            "id": "consultant"
          }
        ],
        "edition": "set 4"
      }
    },
    {
      "op": "read",
      "read": "distribution",
      "args": {
        "item": "arch-100dd",
        "frame": {
          "cutoff": "2026-05-14T12:00-07:00"
        }
      },
      "expect": {
        "distributions": [
          {
            "record": "arch-100dd|arch-100dd|arch-log",
            "at": "2026-05-13T11:45:12-07:00",
            "issuance": "arch-100dd",
            "recipients": [
              "contractor",
              "architect"
            ]
          }
        ],
        "ambiguous": "~absent"
      }
    },
    {
      "op": "read",
      "read": "distribution",
      "args": {
        "item": "arch-100dd",
        "frame": {
          "cutoff": "2026-05-15T12:00-07:00"
        }
      },
      "expect": {
        "distributions": [
          {
            "record": "arch-100dd|arch-100dd|arch-log"
          }
        ],
        "ambiguous": [
          {
            "record": "arch-100dd|dist-0515|arch-log",
            "at": "2026-05-15-07:00",
            "issuance": "arch-100dd",
            "recipients": [
              "consultant"
            ]
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "distribution",
      "args": {
        "item": "arch-100dd",
        "frame": {
          "cutoff": "2026-05-16-07:00"
        }
      },
      "expect": {
        "distributions": [
          {
            "record": "arch-100dd|arch-100dd|arch-log",
            "issuance": "arch-100dd"
          },
          {
            "record": "arch-100dd|dist-0515|arch-log",
            "at": "2026-05-15-07:00",
            "issuance": "arch-100dd",
            "recipients": [
              "consultant"
            ]
          }
        ],
        "ambiguous": "~absent"
      }
    },
    {
      "op": "read",
      "read": "distribution",
      "args": {
        "item": "arch-100dd",
        "frame": {
          "cutoff": "2026-05-16-07:00",
          "perspective": "contractor"
        }
      },
      "expect": {
        "distributions": [
          {
            "record": "arch-100dd|arch-100dd|arch-log"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "distribution",
      "args": {
        "item": "arch-100dd",
        "frame": {
          "cutoff": "2026-05-16-07:00",
          "perspective": "consultant"
        }
      },
      "expect": {
        "distributions": [
          {
            "record": "arch-100dd|arch-100dd|arch-log"
          },
          {
            "record": "arch-100dd|dist-0515|arch-log"
          }
        ]
      }
    }
  ]
}
