  "id": "T18_66_a_review_withdrawn_while_the_revision_changes_nothing_leaves_a_period_of_no_length",
  "family": "T18",
  "rules": [
    "7.6.2",
    "7.2.7",
    "6.7.9",
    "7.6.4",
    "7.6.5",
    "7.6.14",
    "9.5.2",
    "9.5.3",
    "9.5.4",
