      },
      "expect": {
        "in_force": false,
        "properties": {
          "fire_rating": {
            "standing": "not_in_force"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "expectation",
      "args": {
        "ref": "door-101|e-fr|a-601",
        "frame": {
          "cutoff": "2026-06-05T12:00-07:00"
        }
      },
      "expect": {
        "in_force": true,
        "properties": {
          "fire_rating": {
            "standing": "fulfilled",
            "fulfilled_by": "door-101|a601-0601|a-601",
            "qualifying_moment": "2026-06-04T09:00-07:00",
