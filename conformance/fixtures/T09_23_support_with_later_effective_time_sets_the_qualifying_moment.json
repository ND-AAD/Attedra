{
  "id": "T09_23_support_with_later_effective_time_sets_the_qualifying_moment",
  "family": "T09",
  "rules": [
    "6.3.1",
    "6.3.3",
    "8.4.1",
    "6.5.1"
  ],
  "description": "A support taken on 2 June with @effective 4 June starts the in-force period on 4 June. A-601's 1 June evidence then fulfills the non-fresh requirement at 4 June, the later of the evidence time and the establishment time, and the requirement is not in force before then.",
  "steps": [
