          "kind": "schedule",
          "label": "Door schedule A-601"
        },
        {
          "id": "a601-0601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "e-fr",
          "kind": "expectation_context",
          "definition": {
            "@context": {
              "role": "expectation",
              "timing": {
                "type": "by",
                "instant": "2026-06-30-07:00"
              },
              "fresh": false
            }
          }
        },
        {
          "id": "d1",
          "kind": "decision"
        },
        {
          "id": "d1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-0601",
      "source": "a-601",
      "values": {
        "fire_rating": 90
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "e-fr",
      "source": "a-601",
      "values": {
        "fire_rating": 90
      }
    },
    {
      "op": "assert",
      "item": "d1",
      "context": "d1-at",
      "source": "d1",
      "values": {
        "@action": "establish",
        "@targets": [
