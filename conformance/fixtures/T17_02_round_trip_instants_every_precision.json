{
  "id": "T17_02_round_trip_instants_every_precision",
  "family": "T17",
  "rules": [
    "4.2.1",
    "5.1.3",
    "8.1.5",
    "4.4.1",
    "8.4.1"
  ],
  "description": "Instants are retained at the precision and offset written: dates, minutes, seconds and fractional seconds, with negative, positive and zero offsets, in Item definitions, publications and @effective.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "ev-date",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14-07:00"
            }
          }
        },
        {
          "id": "ev-minute",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45-07:00"
            }
          }
        },
        {
          "id": "ev-second",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45:00-07:00"
            }
          }
        },
        {
          "id": "ev-milli",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45:00.250-07:00"
            }
          }
        },
        {
          "id": "ev-micro",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45:00.123456-07:00"
            }
          }
        },
        {
          "id": "ev-plus",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T22:15+05:30"
            }
          }
        },
        {
          "id": "ev-zero",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T16:45:00+00:00"
            }
          }
        },
        {
          "id": "e-by",
          "kind": "expectation-context",
          "definition": {
            "@context": {
              "role": "expectation",
              "timing": {
                "type": "by",
                "instant": "2026-06-27-07:00"
              },
              "fresh": true
            }
          }
        },
        {
          "id": "arch-schedule",
          "kind": "milestone-schedule"
        },
        {
          "id": "arch-dd",
          "kind": "milestone",
          "definition": {
            "@context": {
              "role": "milestone",
              "schedule": {
                "@ref": "item",
                "id": "arch-schedule"
              },
              "stage": "100% DD",
              "ordinal": 300
            }
          }
        },
        {
          "id": "issue-log",
          "kind": "log"
        },
        {
          "id": "contractor",
          "kind": "party"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "wd-1",
          "kind": "withdrawal"
        },
        {
          "id": "wd-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "ev-date"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-05-14-07:00"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "ev-minute"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-05-14T09:45-07:00"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "ev-second"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-05-14T09:45:00-07:00"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "ev-milli"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-05-14T09:45:00.250-07:00"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "ev-micro"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-05-14T09:45:00.123456-07:00"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "ev-plus"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-05-14T22:15+05:30"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "ev-zero"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-05-14T16:45:00+00:00"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "e-by"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "expectation",
            "timing": {
              "type": "by",
              "instant": "2026-06-27-07:00"
            },
            "fresh": true
          }
        }
      }
    },
    {
      "op": "assert",
      "item": "arch-dd",
      "context": "arch-dd",
      "source": "issue-log",
      "values": {
        "@published": "2026-05-13T11:45:12-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-date",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-date",
            "source": "a-601"
          }
        ],
        "@effective": "2026-06-05-07:00"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "arch-dd|arch-dd|issue-log"
      },
      "expect": {
        "status": "found",
        "values": {
          "@published": "2026-05-13T11:45:12-07:00"
        }
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "wd-1|wd-1-at|wd-1"
      },
      "expect": {
        "status": "found",
        "values": {
          "@effective": "2026-06-05-07:00"
        }
      }
    }
  ]
}
