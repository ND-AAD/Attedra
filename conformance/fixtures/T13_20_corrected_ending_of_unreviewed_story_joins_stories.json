{
  "id": "T13_20_corrected_ending_of_unreviewed_story_joins_stories",
  "family": "T13",
  "rules": [
    "7.2.6",
    "7.3.4",
    "7.2.8",
    "9.5.2",
    "9.5.3",
    "12.13"
  ],
  "description": "An unreviewed story ends when A-601's finish is withdrawn on Wednesday; Thursday's lacquer opens story-1+1. When the withdrawal is corrected as erroneous the ending never occurred and both stories are unreviewed, so they are joined by a continuous reconciliation: story-1+1 reads continued_in story-1, and open stories count one disagreement at every cutoff.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-09-91",
          "kind": "specification"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "architect",
          "kind": "party"
        },
        {
          "id": "story-1",
          "kind": "story"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "ev-mon-spec",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T11:00-07:00"
            }
          }
        },
        {
          "id": "story-1/d1",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T17:00-07:00"
            }
          }
        },
        {
          "id": "import-review-log",
          "kind": "process"
        },
        {
          "id": "corr-1",
          "kind": "correction"
        },
        {
          "id": "corr-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-05T10:00-07:00"
            }
          }
        },
        {
          "id": "wd-1",
          "kind": "withdrawal"
        },
        {
          "id": "wd-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "story-1",
      "context": "story-1/d1",
      "source": "story-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "conflict",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          },
          "property": "finish"
        },
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-01T17:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "assert",
      "item": "wd-1",
      "context": "wd-1-at",
      "source": "wd-1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          }
        ],
        "@party": {
          "@ref": "item",
          "id": "architect"
        }
      }
    },
    {
      "op": "items",
      "items": [
        {
          "id": "ev-thu-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-thu-a601",
      "source": "a-601",
      "values": {
        "finish": "lacquer"
      }
    },
    {
      "op": "read",
      "read": "open_stories",
      "args": {
        "frame": {
          "cutoff": "2026-06-03T12:00-07:00"
        }
      },
      "expect": {
        "stories": [],
        "count": 0,
        "ambiguous": [],
        "limitations": [],
        "filter": null
      }
    },
    {
      "op": "read",
      "read": "open_stories",
      "args": {
        "frame": {
          "cutoff": "2026-06-04-07:00"
        }
      },
      "expect": {
        "stories": [
          "story-1+1"
        ],
        "count": 1,
        "ambiguous": [],
        "limitations": [],
        "filter": null
      }
    },
    {
      "op": "assert",
      "item": "corr-1",
      "context": "corr-1-at",
      "source": "import-review-log",
      "values": {
        "@action": "correct",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "wd-1",
            "context": "wd-1-at",
            "source": "wd-1"
          }
        ],
        "@outcome": "erroneous",
        "@basis": [
          {
            "@ref": "artifact",
            "id": "a-601-rev-3.pdf",
            "edition": "rev 3"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1+1",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "acts": [
          "~any"
        ],
        "standing": {
          "open": "continued_in",
          "continued_in": "story-1"
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "acts": [
          "~any"
        ],
        "interval": {
          "start": "2026-06-01T11:00-07:00",
          "end": null
        },
        "ending": null,
        "standing": {
          "open": "open",
          "review": "unreviewed",
          "disagreement": "disagreeing"
        }
      }
    },
    {
      "op": "read",
      "read": "open_stories",
      "args": {
        "frame": {
          "cutoff": "2026-06-03T12:00-07:00"
        }
      },
      "expect": {
        "stories": [
          "story-1"
        ],
        "count": 1,
        "ambiguous": [],
        "limitations": [],
        "filter": null
      }
    },
    {
      "op": "read",
      "read": "open_stories",
      "args": {
        "frame": {
          "cutoff": "2026-06-04-07:00"
        }
      },
      "expect": {
        "stories": [
          "story-1"
        ],
        "count": 1,
        "ambiguous": [],
        "limitations": [],
        "filter": null
      }
    },
    {
      "op": "read",
      "read": "open_stories",
      "args": {
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "stories": [
          "story-1"
        ],
        "count": 1,
        "ambiguous": [],
        "limitations": [],
        "filter": null
      }
    },
    {
      "op": "read",
      "read": "pending_review",
      "args": {
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "stories": [
          "story-1"
        ],
        "count": 1
      }
    }
  ]
}
