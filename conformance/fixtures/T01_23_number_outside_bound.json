{
  "id": "T01_23_number_outside_bound",
  "family": "T01",
  "rules": [
    "5.1.2",
    "10.2.4"
  ],
  "description": "A number beyond 34 significant digits or an exponent beyond plus or minus 999 is rejected with number_out_of_range rather than approximated.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "ev-0514",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "a-601",
      "values_json": "{\"width\": 12345678901234567890123456789012345}",
      "expect_error": "number_out_of_range"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "a-601",
      "values_json": "{\"width\": 0.12345678901234567890123456789012345}",
      "expect_error": "number_out_of_range"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "a-601",
      "values_json": "{\"width\": 1E+1000}",
      "expect_error": "number_out_of_range"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-0514",
      "source": "a-601",
      "values_json": "{\"width\": 1E-1000}",
      "expect_error": "number_out_of_range"
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-0514|a-601"
      },
      "expect": {
        "status": "not_found"
      }
    }
  ],
  "note": "5.1.2 is a fixed, portable bound."
}