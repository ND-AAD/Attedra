{
  "id": "T13_35_no_continuation_for_evidence_that_occurred_before_the_story_was_recorded",
  "family": "T13",
  "rules": [
    "7.2.8",
    "7.2.5",
    "7.2.4",
    "9.5.1"
  ],
  "description": "Maintenance records a continuation only for evidence a write brings into an unreviewed story. A story first recorded on Wednesday at 17:00 gains no detection when a Tuesday A-601 revision is backfilled later, because that change occurred before the story was recorded; its interval still derives from the evidence. A Thursday revision recorded afterwards is continued as story-1/d2.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-09-91",
          "kind": "specification"
        },
        {
          "id": "story-1",
          "kind": "story"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "ev-mon-spec",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T11:00-07:00"
            }
          }
        },
        {
          "id": "story-1/d1",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T17:00-07:00"
            }
          }
        },
        {
          "id": "ev-tue-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T09:00-07:00"
            }
          }
        },
        {
          "id": "ev-thu-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "story-1",
      "context": "story-1/d1",
      "source": "story-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "conflict",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          },
          "property": "finish"
        },
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-03T17:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-tue-a601",
      "source": "a-601",
      "values": {
        "finish": "brown-paint"
      },
      "expect": {
        "status": "inserted",
        "generated": []
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "story-1|story-1/d2|story-1"
      },
      "expect": {
        "status": "not_found"
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "detections": [
          "story-1|story-1/d1|story-1"
        ],
        "related": [],
        "interval": {
          "start": "2026-06-01T11:00-07:00",
          "end": null
        },
        "standing": {
          "open": "open"
        }
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-thu-a601",
      "source": "a-601",
      "values": {
        "finish": "lacquer"
      },
      "expect": {
        "status": "inserted",
        "generated": [
          "story-1|story-1/d2|story-1"
        ]
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "story-1/d2"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-06-04T09:00-07:00"
          }
        }
      }
    }
  ]
}
