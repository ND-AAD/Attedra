{
  "id": "T15_02_changed_content_at_occupied_triple_rejected",
  "family": "T15",
  "rules": [
    "8.1.3",
    "10.2.1",
    "8.1.2",
    "5.5.3",
    "I-8",
    "12.15"
  ],
  "description": "A write to an occupied triple with different content fails with occupied and leaves the record unchanged: a changed value, an omitted property (no merge) and an added property are all rejected, and a value equal only under a domain interpretation is not identical content.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "spec-09-91",
          "kind": "specification"
        },
        {
          "id": "ev-mon-spec",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T11:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint",
        "hardware": "HW-1"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "stain",
        "hardware": "HW-1"
      },
      "expect_error": "occupied"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      },
      "expect_error": "occupied"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint",
        "hardware": "HW-1",
        "mark": "101"
      },
      "expect_error": "occupied"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "fire_rating": "90 min"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "fire_rating": "1.5 h"
      },
      "expect_error": "occupied"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "hardware": "HW-1",
        "finish": "paint"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-mon-a601|a-601"
      },
      "expect": {
        "status": "found",
        "values": {
          "finish": "paint",
          "hardware": "HW-1",
          "mark": "~absent"
        }
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-mon-spec|spec-09-91"
      },
      "expect": {
        "status": "found",
        "values": {
          "fire_rating": "90 min"
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-02-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|ev-mon-a601|a-601"
          },
          "hardware": {
            "classification": "asserted",
            "value": "HW-1",
            "origin": "door-101|ev-mon-a601|a-601"
          }
        }
      }
    }
  ]
}
