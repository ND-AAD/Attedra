    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "chg-1",
          "kind": "story"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
