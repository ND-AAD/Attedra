{
  "id": "T13_40_every_open_change_story_is_listed_and_counted_including_a_related_change_story",
  "family": "T13",
  "rules": [
    "9.5.3",
    "9.5.4",
    "7.3.7",
    "7.2.7",
    "7.2.8",
    "7.2.3"
  ],
  "description": "Counting once applies to conflict-story families only. A Tuesday lacquer issuance entered on Saturday falls inside the unreviewed paint-to-stain change story chg-1, so maintenance records a reconstructed reconciliation and the related change story chg-1+1 (paint to lacquer). Both change stories are open, and both are listed and counted in open stories and pending review; neither is superseded. Before chg-1's revision occurs, only chg-1+1 is listed. Approving chg-1+1 ends it, and chg-1 still awaits its own review.",
