          },
          "cutoff": "2026-06-01T17:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "assert",
      "item": "ign-1",
      "context": "ign-1-at",
      "source": "ign-1",
      "values": {
        "@action": "ignore",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "story-1",
            "context": "story-1/d1",
            "source": "story-1"
          }
        ],
        "@party": {
          "@ref": "item",
          "id": "owner"
        },
        "@until": "2026-06-05T17:00-07:00"
      }
    },
    {
