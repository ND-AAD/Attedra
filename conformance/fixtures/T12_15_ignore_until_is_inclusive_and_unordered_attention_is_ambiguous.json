      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "story-1",
      "context": "story-1/d1",
      "source": "story-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "conflict",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          },
          "property": "finish"
        },
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
