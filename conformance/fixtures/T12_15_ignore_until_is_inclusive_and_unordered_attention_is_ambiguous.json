{
  "id": "T12_15_ignore_until_is_inclusive_and_unordered_attention_is_ambiguous",
  "family": "T12",
  "rules": [
    "9.5.6",
    "9.5.5",
    "9.5.2",
    "4.2.5",
    "9.5.3",
    "9.5.4"
  ],
  "description": "An ignore with @until is in effect from its effective time while the cutoff is at or before @until, and lapses once the cutoff is after it: at exactly 17:00 the story reads ignored, at 17:01 attended. A date cutoff on the @until day is unordered with a 17:00 @until, so attention reads ambiguous; under the attention filter the story is then listed among the ambiguous entries in place of stories, and without the filter it is listed and counted as usual.",
