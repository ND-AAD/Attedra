{
  "id": "T12_06_reader_interpretation_reports_match_without_changing_story",
  "family": "T12",
  "rules": [
    "7.2.4",
    "9.5.1",
    "9.5.2",
    "5.5.3",
    "5.5.4",
    "9.4.2",
    "9.4.3",
    "12.12"
  ],
  "description": "A fire-rating story recorded under the literal comparison (\"90 min\" against \"1.5 h\") stays open and disagreeing for a reader using the fixture fire-rating interpretation, and that reader is told the sides match under it. A reader whose interpretation equals the story's gets no match field. The conflict read itself follows the reader's interpretation and names it.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-09-91",
          "kind": "specification"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "architect",
          "kind": "party"
        },
        {
          "id": "story-1",
          "kind": "story"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "ev-mon-spec",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T11:00-07:00"
            }
          }
        },
        {
          "id": "story-1/d1",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T17:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "fire_rating": "90 min"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "fire_rating": "1.5 h"
      }
    },
    {
      "op": "assert",
      "item": "story-1",
      "context": "story-1/d1",
      "source": "story-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "conflict",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          },
          "property": "fire_rating"
        },
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "fire_rating"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "fire_rating"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-01T17:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "2026-06-02-07:00",
          "interpretation": "fixture-fire-rating"
        }
      },
      "expect": {
        "standing": {
          "open": "open",
          "disagreement": "disagreeing"
        },
        "ending": null,
        "match_under_read_interpretation": true
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "2026-06-02-07:00"
        }
      },
      "expect": {
        "standing": {
          "open": "open",
          "disagreement": "disagreeing"
        },
        "match_under_read_interpretation": "~absent"
      }
    },
    {
      "op": "read",
      "read": "open_stories",
      "args": {
        "frame": {
          "cutoff": "2026-06-02-07:00",
          "interpretation": "fixture-fire-rating"
        }
      },
      "expect": {
        "stories": [
          "story-1"
        ],
        "count": 1,
        "ambiguous": [],
        "limitations": [],
        "filter": null
      }
    },
    {
      "op": "read",
      "read": "pending_review",
      "args": {
        "frame": {
          "cutoff": "2026-06-02-07:00",
          "interpretation": "fixture-fire-rating"
        }
      },
      "expect": {
        "stories": [
          "story-1"
        ],
        "count": 1
      }
    },
    {
      "op": "read",
      "read": "conflicts",
      "args": {
        "subject": "door-101",
        "frame": {
          "cutoff": "2026-06-02-07:00"
        }
      },
      "expect": {
        "conflicts": [
          {
            "property": "fire_rating",
            "sides": [
              {
                "source": "a-601",
                "value": "90 min",
                "origin": "door-101|ev-mon-a601|a-601"
              },
              {
                "source": "spec-09-91",
                "value": "1.5 h",
                "origin": "door-101|ev-mon-spec|spec-09-91"
              }
            ]
          }
        ],
        "interpretation": null
      }
    },
    {
      "op": "read",
      "read": "conflicts",
      "args": {
        "subject": "door-101",
        "frame": {
          "cutoff": "2026-06-02-07:00",
          "interpretation": "fixture-fire-rating"
        }
      },
      "expect": {
        "conflicts": [],
        "interpretation": "fixture-fire-rating"
      }
    }
  ]
}
