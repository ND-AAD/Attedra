{
  "id": "T16_02_second_cycle_history_reconstructed_from_acts",
  "family": "T16",
  "rules": [
    "8.6.3",
    "8.6.4",
    "2.2.4",
    "12.16"
  ],
  "description": "A second cycle (disconnected Saturday, reconnected the following Monday) leaves the full history readable from the acts: a Wednesday read still reports inactive, Friday active, Sunday inactive and the next Tuesday active; the original Monday connection time is never replaced.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "room-12",
          "kind": "room",
          "label": "Room 12"
        },
        {
          "id": "door-101",
          "kind": "door",
          "label": "Door 101"
        }
      ]
    },
    {
      "op": "items",
      "items": [
        {
          "id": "disc-1",
          "kind": "disconnection"
        },
        {
          "id": "disc-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T09:00-07:00"
            }
          }
        },
        {
          "id": "recon-1",
          "kind": "reconnection"
        },
        {
          "id": "recon-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T09:00-07:00"
            }
          }
        },
        {
          "id": "disc-2",
          "kind": "disconnection"
        },
        {
          "id": "disc-2-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-06T09:00-07:00"
            }
          }
        },
        {
          "id": "recon-2",
          "kind": "reconnection"
        },
        {
          "id": "recon-2-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-08T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "room-12",
      "to": "door-101",
      "at": "2026-06-01T09:00-07:00"
    },
    {
      "op": "assert",
      "item": "disc-1",
      "context": "disc-1-at",
      "source": "disc-1",
      "values": {
        "@action": "disconnect",
        "@targets": [
          {
            "@ref": "connection",
            "from": "room-12",
            "to": "door-101"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "recon-1",
      "context": "recon-1-at",
      "source": "recon-1",
      "values": {
        "@action": "reconnect",
        "@targets": [
          {
            "@ref": "connection",
            "from": "room-12",
            "to": "door-101"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "disc-2",
      "context": "disc-2-at",
      "source": "disc-2",
      "values": {
        "@action": "disconnect",
        "@targets": [
          {
            "@ref": "connection",
            "from": "room-12",
            "to": "door-101"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "recon-2",
      "context": "recon-2-at",
      "source": "recon-2",
      "values": {
        "@action": "reconnect",
        "@targets": [
          {
            "@ref": "connection",
            "from": "room-12",
            "to": "door-101"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "adjacency",
      "args": {
        "item": "door-101",
        "frame": {
          "cutoff": "2026-06-03T12:00-07:00"
        }
      },
      "expect": {
        "outgoing": [],
        "incoming": []
      }
    },
    {
      "op": "read",
      "read": "adjacency",
      "args": {
        "item": "door-101",
        "frame": {
          "cutoff": "2026-06-05T12:00-07:00"
        }
      },
      "expect": {
        "outgoing": [],
        "incoming": [
          "room-12"
        ]
      }
    },
    {
      "op": "read",
      "read": "adjacency",
      "args": {
        "item": "door-101",
        "frame": {
          "cutoff": "2026-06-07T12:00-07:00"
        }
      },
      "expect": {
        "outgoing": [],
        "incoming": []
      }
    },
    {
      "op": "read",
      "read": "adjacency",
      "args": {
        "item": "door-101",
        "frame": {
          "cutoff": "2026-06-09T12:00-07:00"
        }
      },
      "expect": {
        "outgoing": [],
        "incoming": [
          "room-12"
        ]
      }
    },
    {
      "op": "read",
      "read": "adjacency",
      "args": {
        "item": "door-101",
        "frame": {},
        "history": true
      },
      "expect": {
        "history": {
          "room-12->door-101": [
            {
              "state": "active",
              "from": "2026-06-01T09:00-07:00",
              "to": "2026-06-02T09:00-07:00"
            },
            {
              "state": "inactive",
              "from": "2026-06-02T09:00-07:00",
              "to": "2026-06-04T09:00-07:00"
            },
            {
              "state": "active",
              "from": "2026-06-04T09:00-07:00",
              "to": "2026-06-06T09:00-07:00"
            },
            {
              "state": "inactive",
              "from": "2026-06-06T09:00-07:00",
              "to": "2026-06-08T09:00-07:00"
            },
            {
              "state": "active",
              "from": "2026-06-08T09:00-07:00",
              "to": null
            }
          ]
        }
      }
    }
  ]
}
