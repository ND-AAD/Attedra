              "item": "door-101",
              "context": "arch-cd",
              "source": "a-601",
              "property": "~absent"
            },
            "cause": "disagreement"
          },
          "@basis": [
            {
              "@ref": "assertion",
              "item": "arch-cd",
              "context": "arch-cd",
              "source": "arch-issue-log"
            }
          ]
        }
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "story-1/v1/at"
      },
      "expect": {
        "status": "found",
        "definition": {
          "@context": {
            "role": "event",
            "at": "2026-06-03T10:00-07:00"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
