      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "finish": "stain"
      },
      "expect": {
        "status": "inserted",
        "ref": "door-101|ev-mon-spec|spec-09-91",
        "generated": [],
        "transition_acts": []
