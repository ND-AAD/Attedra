        "periods": [
          {
            "begin": {
              "act": "story-1|story-1/b1|story-1",
              "at": "2026-06-03T10:00-07:00",
              "record": "door-101|arch-cd|a-601",
              "cause": "disagreement",
              "revised_by": "story-1/v1|story-1/v1/at|story-1/v1"
            },
            "end": null,
            "policy_end": "~absent"
          }
        ],
        "standing": {
          "open": "open",
          "disagreement": "disagreeing"
