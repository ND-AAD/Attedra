            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-02T17:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      },
      "expect": {
        "status": "inserted",
        "ref": "story-1|story-1/d1|story-1",
        "generated": [],
        "transition_acts": [
          "story-1|story-1/b1|story-1"
        ]
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "story-1|story-1/b1|story-1"
