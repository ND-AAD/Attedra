{
  "id": "T11_12_unchanged_properties_in_the_changes_read_not_in_story_transitions",
  "family": "T11",
  "rules": [
    "5.6.2",
    "7.2.3",
    "9.4.1",
    "5.2.1",
    "9.5.1"
  ],
  "description": "A partial reissue that omits hardware leaves it unchanged by carry-forward. The changes read reports every property the source asserted, in property-name order, with hardware as unchanged (both sides originate in the DD issue). Unchanged properties are not transitions of the revision: the change-story detection lists only finish, and the story read reports one transition, coming from its detection.",
