    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "chg-1",
          "kind": "story"
        },
        {
          "id": "ev-dd",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-13T10:00-07:00"
            }
          }
        },
        {
          "id": "ev-cd",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-16T10:00-07:00"
            }
          }
        },
        {
          "id": "chg-1/d1",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-16T12:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-dd",
      "source": "a-601",
      "values": {
        "finish": "paint",
        "hardware": "HW-1"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-cd",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-101",
        "from": {
          "cutoff": "2026-06-01-07:00"
        },
        "to": {
          "cutoff": "2026-06-30-07:00"
        }
