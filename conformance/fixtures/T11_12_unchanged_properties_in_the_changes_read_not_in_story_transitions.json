      "expect": {
        "transitions": [
          {
            "property": "finish",
            "transition": "changed",
            "prior": "door-101|ev-dd|a-601",
            "new": "door-101|ev-cd|a-601",
            "members": []
          },
          {
            "property": "hardware",
            "transition": "unchanged",
            "prior": "door-101|ev-dd|a-601",
            "new": "door-101|ev-dd|a-601",
            "members": []
          }
        ],
        "interpretation": null
      }
    },
    {
      "op": "assert",
      "item": "chg-1",
      "context": "chg-1/d1",
      "source": "chg-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "change",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          }
        },
        "@transitions": [
          {
            "property": "finish",
            "transition": "changed",
            "prior": {
              "@ref": "assertion",
              "item": "door-101",
              "context": "ev-dd",
              "source": "a-601"
            },
            "new": {
              "@ref": "assertion",
              "item": "door-101",
              "context": "ev-cd",
              "source": "a-601"
            }
          }
        ],
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-dd",
            "source": "a-601"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-cd",
            "source": "a-601"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-16T12:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "chg-1",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "kind": "change",
        "transitions": [
          {
            "property": "finish",
            "transition": "changed",
            "prior": "door-101|ev-dd|a-601",
            "new": "door-101|ev-cd|a-601"
          }
        ],
        "transitions_from": "chg-1|chg-1/d1|chg-1",
        "transition_corrections": "~absent",
        "standing": {
          "open": "open",
          "review": "unreviewed"
        }
      }
    }
  ]
}
