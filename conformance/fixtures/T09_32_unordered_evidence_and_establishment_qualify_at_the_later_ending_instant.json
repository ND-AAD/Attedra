{
  "id": "T09_32_unordered_evidence_and_establishment_qualify_at_the_later_ending_instant",
  "family": "T09",
  "rules": [
    "6.5.1",
    "4.2.5",
    "4.5.3",
    "6.2.2",
    "4.6.1"
  ],
  "description": "For a non-fresh expectation established at 10:00 on 2 June, A-601 evidence dated only 2 June is unordered with the establishment, but every condition holds under either order, so the property is fulfilled, not ambiguous, at the instant whose interval ends later: the date. A cutoff at 12:00 that day is itself unordered with that date, so there the standing is ambiguous.",
