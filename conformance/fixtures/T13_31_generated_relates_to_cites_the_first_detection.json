          }
        ],
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-tue-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-03T10:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        },
        "@outcome": "no_change",
        "@party": {
          "@ref": "item",
          "id": "owner"
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "2026-06-03T12:00-07:00"
        }
      },
      "expect": {
        "acts": [
          "rv-1|rv-1-at|rv-1"
        ],
        "standing": {
          "review": "reviewed"
        }
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-thu-a601",
      "source": "a-601",
      "values": {
        "finish": "lacquer"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "story-1+1|story-1+1/d1|story-1+1"
      },
      "expect": {
        "status": "found",
        "values": {
          "@action": "detect",
          "@relates_to": {
            "@ref": "assertion",
            "item": "story-1",
            "context": "story-1/d1",
            "source": "story-1"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "detections": [
          "story-1|story-1/d1|story-1",
          "story-1|story-1/d2|story-1"
        ],
        "related": [
          "story-1+1"
        ],
        "standing": {
          "review": "reviewed"
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1+1",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "related": [
          "story-1"
        ],
        "standing": {
          "open": "open",
          "review": "unreviewed"
        }
      }
    }
  ]
