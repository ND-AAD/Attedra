        },
        {
          "id": "ev-tue-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T09:00-07:00"
            }
          }
        },
        {
          "id": "rv-1",
          "kind": "decision"
        },
        {
          "id": "rv-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T10:00-07:00"
            }
          }
        },
        {
          "id": "ev-thu-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-04T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "story-1",
      "context": "story-1/d1",
      "source": "story-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "conflict",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          },
          "property": "finish"
        },
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-01T17:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-tue-a601",
      "source": "a-601",
      "values": {
