{
  "id": "T13_31_generated_relates_to_cites_the_first_detection",
  "family": "T13",
  "rules": [
    "7.3.1",
    "7.2.1",
    "7.2.5",
    "7.4.1",
    "7.2.8"
  ],
  "description": "Any detection of a story identifies it: a review that targets story-1's continuation detection reviews story-1. When a later change opens a related story, maintenance cites the prior story's first detection in @relates_to, not the detection the review targeted.",
