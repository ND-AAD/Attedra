{
  "id": "T18_45_a_change_story_whose_revision_a_normalization_leaves_changing_nothing_ends_and_does_not_reopen",
  "family": "T18",
  "rules": [
    "7.3.8",
    "7.2.7",
    "7.6.2",
    "7.6.5",
    "6.7.9",
    "9.5.2",
    "9.5.4",
    "9.5.7",
