{
  "id": "T01_09_kind_never_changes_behaviour",
  "family": "T01",
  "rules": [
    "2.1.2",
    "2.1.6",
    "4.1.1",
    "3.3.4"
  ],
  "description": "The model reserves no kind values: Items whose kinds resemble model vocabulary behave as ordinary Items, and a context Item works by its definition whatever its kind.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-0991",
          "kind": "specification"
        },
        {
          "id": "ev-1",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45-07:00"
            }
          }
        },
        {
          "id": "thing-1",
          "kind": "milestone"
        },
        {
          "id": "src-x",
          "kind": "expectation"
        },
        {
          "id": "src-y",
          "kind": "story"
        },
        {
          "id": "ctx-2",
          "kind": "door",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-14T09:45-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-1",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-1",
      "source": "spec-0991",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "thing-1",
      "context": "ctx-2",
      "source": "src-x",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "thing-1",
      "context": "ctx-2",
      "source": "src-y",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "read",
      "read": "conflicts",
      "args": {
        "subject": "door-101",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "conflicts": [
          {
            "property": "finish",
            "sides": [
              {
                "source": "a-601",
                "value": "paint",
                "origin": "door-101|ev-1|a-601"
              },
              {
                "source": "spec-0991",
                "value": "stain",
                "origin": "door-101|ev-1|spec-0991"
              }
            ]
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "conflicts",
      "args": {
        "subject": "thing-1",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "conflicts": [
          {
            "property": "finish",
            "sides": [
              {
                "source": "src-x",
                "value": "paint",
                "origin": "thing-1|ctx-2|src-x"
              },
              {
                "source": "src-y",
                "value": "stain",
                "origin": "thing-1|ctx-2|src-y"
              }
            ]
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "thing-1",
        "source": "src-y",
        "frame": {
          "cutoff": "now"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "stain",
            "origin": "thing-1|ctx-2|src-y"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "thing-1",
        "source": "src-x",
        "frame": {
          "cutoff": "2026-05-13-07:00"
        },
        "properties": [
          "finish"
        ]
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "never_asserted",
            "value": "~absent",
            "origin": "~absent"
          }
        }
      }
    }
  ]
}
