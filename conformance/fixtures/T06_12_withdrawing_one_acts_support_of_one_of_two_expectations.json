{
  "id": "T06_12_withdrawing_one_acts_support_of_one_of_two_expectations",
  "family": "T06",
  "rules": [
    "6.7.2",
    "2.4.3",
    "6.1.4",
    "6.3.2"
  ],
  "description": "D1 establishes expectations on Door 101 and Door 102. Withdrawing D1's support of the Door 101 expectation ends only that support: Door 101's expectation is withdrawn and Door 102's stays outstanding.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door",
          "label": "Door 101"
        },
        {
          "id": "door-102",
          "kind": "door",
          "label": "Door 102"
        },
        {
          "id": "a-601",
          "kind": "schedule",
          "label": "Door schedule A-601"
        },
        {
          "id": "e-fin",
          "kind": "expectation_context",
          "definition": {
            "@context": {
              "role": "expectation",
              "timing": {
                "type": "by",
                "instant": "2026-06-30-07:00"
              },
              "fresh": false
            }
          }
        },
        {
          "id": "d1",
          "kind": "decision"
        },
        {
          "id": "d1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "w1",
          "kind": "withdrawal"
        },
        {
          "id": "w1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "e-fin",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "door-102",
      "context": "e-fin",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "d1",
      "context": "d1-at",
      "source": "d1",
      "values": {
        "@action": "establish",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "e-fin",
            "source": "a-601"
          },
          {
            "@ref": "assertion",
            "item": "door-102",
            "context": "e-fin",
            "source": "a-601"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "w1",
      "context": "w1-at",
      "source": "w1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "d1",
            "context": "d1-at",
            "source": "d1",
            "support": {
              "@ref": "assertion",
              "item": "door-101",
              "context": "e-fin",
              "source": "a-601"
            }
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "expectation",
      "args": {
        "ref": "door-101|e-fin|a-601",
        "frame": {
          "cutoff": "2026-06-02T12:00-07:00"
        }
      },
      "expect": {
        "in_force": false,
        "properties": {
          "finish": {
            "standing": "withdrawn",
            "withdrawn_by": [
              "w1|w1-at|w1"
            ]
          }
        }
      }
    },
    {
      "op": "read",
      "read": "expectation",
      "args": {
        "ref": "door-102|e-fin|a-601",
        "frame": {
          "cutoff": "2026-06-02T12:00-07:00"
        }
      },
      "expect": {
        "in_force": true,
        "supports": [
          {
            "support": "d1|d1-at|d1",
            "covers": [
              "finish"
            ],
            "withdrawn_by": []
          }
        ],
        "properties": {
          "finish": {
            "standing": "outstanding",
            "overdue": false
          }
        }
      }
    }
  ],
  "note": "9.3.1: the expectation read returns \"its supports, meaning every support whose occurrence time is at or before the cutoff, each with the properties it covers at the cutoff and, for coverage that has ended or never began, the withdrawals that ended it (6.3.3, 6.7.2)\". README section 5 gives each as {\"support\", \"covers\", \"withdrawn_by\"}. Step 7: `supports` lists <support> objects; every support listed covers all of the expectation's properties at that cutoff and none was withdrawn, and no other support occurred by then."
}
