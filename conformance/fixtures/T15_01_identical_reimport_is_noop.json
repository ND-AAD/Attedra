{
  "id": "T15_01_identical_reimport_is_noop",
  "family": "T15",
  "rules": [
    "8.1.2",
    "5.3.2",
    "5.5.1",
    "5.1.3",
    "I-8",
    "12.15"
  ],
  "description": "Re-importing an Assertion whose values are equal after normalization (an empty string for null, keys in another order, 1.0 for 1) succeeds and changes nothing: the exact read returns the original content and the source position is unchanged.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values_json": "{\"finish\": \"paint\", \"count\": 1, \"note\": null, \"dims\": {\"width\": 900, \"height\": 2100}}"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values_json": "{\"dims\": {\"height\": 2100, \"width\": 900}, \"note\": \"\", \"count\": 1.0, \"finish\": \"paint\"}"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values_json": "{\"finish\": \"paint\", \"count\": 1, \"note\": null, \"dims\": {\"width\": 900, \"height\": 2100}}"
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|ev-mon-a601|a-601"
      },
      "expect": {
        "status": "found",
        "values": {
          "finish": "paint",
          "count": 1,
          "note": null,
          "dims": {
            "width": 900,
            "height": 2100
          }
        },
        "corrections": [],
        "withdrawals": [],
        "dependents": []
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-02-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-101|ev-mon-a601|a-601"
          },
          "count": {
            "classification": "asserted",
            "value": 1,
            "origin": "door-101|ev-mon-a601|a-601"
          },
          "note": {
            "classification": "asserted",
            "value": null,
            "origin": "door-101|ev-mon-a601|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "by_party",
      "args": {
        "frame": {
          "cutoff": "now"
        },
        "source": "a-601"
      },
      "expect": {
        "statements": [
          "door-101|ev-mon-a601|a-601"
        ],
        "acts": []
      }
    }
  ]
}
