{
  "id": "T03_06_member_level_differences",
  "family": "T03",
  "rules": [
    "5.6.2",
    "9.4.1",
    "5.4.1"
  ],
  "description": "A changed structured value reports its member-level differences: an added member, a changed member, and removed members, so a missing member can be identified.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "door-102",
          "kind": "door"
        },
        {
          "id": "door-103",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "ev-dd",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-05-13T10:00-07:00"
            }
          }
        },
        {
          "id": "ev-cd",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-16T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-dd",
      "source": "a-601",
      "values": {
        "dimensions": {
          "height": 2200
        }
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-cd",
      "source": "a-601",
      "values": {
        "dimensions": {
          "height": 2200,
          "width": 900
        }
      }
    },
    {
      "op": "assert",
      "item": "door-102",
      "context": "ev-dd",
      "source": "a-601",
      "values": {
        "dimensions": {
          "width": 900,
          "height": 2100
        }
      }
    },
    {
      "op": "assert",
      "item": "door-102",
      "context": "ev-cd",
      "source": "a-601",
      "values": {
        "dimensions": {
          "width": 910,
          "height": 2100
        }
      }
    },
    {
      "op": "assert",
      "item": "door-103",
      "context": "ev-dd",
      "source": "a-601",
      "values": {
        "dimensions": {
          "width": 900,
          "height": 2100,
          "note": "undercut"
        }
      }
    },
    {
      "op": "assert",
      "item": "door-103",
      "context": "ev-cd",
      "source": "a-601",
      "values": {
        "dimensions": {
          "width": 900
        }
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-101",
        "from": {
          "cutoff": "2026-06-01-07:00"
        },
        "to": {
          "cutoff": "2026-06-30-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "dimensions",
            "transition": "changed",
            "prior": "door-101|ev-dd|a-601",
            "new": "door-101|ev-cd|a-601",
            "members": [
              {
                "member": "width",
                "difference": "member_added"
              }
            ]
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-102",
        "from": {
          "cutoff": "2026-06-01-07:00"
        },
        "to": {
          "cutoff": "2026-06-30-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "dimensions",
            "transition": "changed",
            "prior": "door-102|ev-dd|a-601",
            "new": "door-102|ev-cd|a-601",
            "members": [
              {
                "member": "width",
                "difference": "member_changed"
              }
            ]
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-103",
        "from": {
          "cutoff": "2026-06-01-07:00"
        },
        "to": {
          "cutoff": "2026-06-30-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "dimensions",
            "transition": "changed",
            "prior": "door-103|ev-dd|a-601",
            "new": "door-103|ev-cd|a-601",
            "members": [
              "~unordered",
              {
                "member": "height",
                "difference": "member_removed"
              },
              {
                "member": "note",
                "difference": "member_removed"
              }
            ]
          }
        ]
      }
    }
  ]
}
