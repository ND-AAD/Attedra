{
  "id": "T12_09_review_takes_effect_at_its_effective_time",
  "family": "T12",
  "rules": [
    "8.4.1",
    "9.5.2",
    "9.5.4",
    "7.4.1"
  ],
  "description": "A review recorded at Wednesday's meeting with @effective Friday reviews the story only from Friday: a Thursday frame shows it unreviewed and pending, a Friday frame reviewed and not pending.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-09-91",
          "kind": "specification"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "architect",
          "kind": "party"
        },
        {
          "id": "story-1",
          "kind": "story"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "ev-mon-spec",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T11:00-07:00"
            }
          }
        },
        {
          "id": "story-1/d1",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T17:00-07:00"
            }
          }
        },
        {
          "id": "rv-1",
          "kind": "decision"
        },
        {
          "id": "rv-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "story-1",
      "context": "story-1/d1",
      "source": "story-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "conflict",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          },
          "property": "finish"
        },
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-01T17:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "assert",
      "item": "rv-1",
      "context": "rv-1-at",
      "source": "rv-1",
      "values": {
        "@action": "review",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "story-1",
            "context": "story-1/d1",
            "source": "story-1"
          }
        ],
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-03T10:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        },
        "@outcome": "no_change",
        "@party": {
          "@ref": "item",
          "id": "owner"
        },
        "@effective": "2026-06-05T10:00-07:00"
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "2026-06-04T12:00-07:00"
        }
      },
      "expect": {
        "standing": {
          "open": "open",
          "review": "unreviewed"
        }
      }
    },
    {
      "op": "read",
      "read": "pending_review",
      "args": {
        "frame": {
          "cutoff": "2026-06-04T12:00-07:00"
        }
      },
      "expect": {
        "stories": [
          "story-1"
        ],
        "count": 1
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "2026-06-05T12:00-07:00"
        }
      },
      "expect": {
        "standing": {
          "open": "open",
          "review": "reviewed"
        }
      }
    },
    {
      "op": "read",
      "read": "pending_review",
      "args": {
        "frame": {
          "cutoff": "2026-06-05T12:00-07:00"
        }
      },
      "expect": {
        "stories": [],
        "count": 0
      }
    }
  ]
}
