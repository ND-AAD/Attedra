{
  "id": "T13_23_tied_revision_after_review_by_after_opens_related_story",
  "family": "T13",
  "rules": [
    "7.3.6",
    "4.5.2",
    "7.3.1",
    "4.5.1",
    "12.13"
  ],
  "description": "A review and an A-601 revision occur at the same instant (Wednesday 10:00, distinct contexts). The revision carries @after referencing the review, so it is after the review: it does not continue the reviewed story but opens a related story. Nothing at that instant is ambiguous.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project",
          "kind": "project"
        },
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "a-601",
          "kind": "door-schedule"
        },
        {
          "id": "spec-09-91",
          "kind": "specification"
        },
        {
          "id": "owner",
          "kind": "party"
        },
        {
          "id": "architect",
          "kind": "party"
        },
        {
          "id": "story-1",
          "kind": "story"
        },
        {
          "id": "ev-mon-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "ev-mon-spec",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T11:00-07:00"
            }
          }
        },
        {
          "id": "story-1/d1",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T17:00-07:00"
            }
          }
        },
        {
          "id": "rv-1",
          "kind": "decision"
        },
        {
          "id": "rv-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T10:00-07:00"
            }
          }
        },
        {
          "id": "ev-wed-a601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T10:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project",
      "to": "door-101",
      "at": "2026-05-01-07:00"
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-a601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-mon-spec",
      "source": "spec-09-91",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "story-1",
      "context": "story-1/d1",
      "source": "story-1",
      "values": {
        "@action": "detect",
        "@story": {
          "kind": "conflict",
          "subject": {
            "@ref": "item",
            "id": "door-101"
          },
          "property": "finish"
        },
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-01T17:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        }
      }
    },
    {
      "op": "assert",
      "item": "rv-1",
      "context": "rv-1-at",
      "source": "rv-1",
      "values": {
        "@action": "review",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "story-1",
            "context": "story-1/d1",
            "source": "story-1"
          }
        ],
        "@basis": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-a601",
            "source": "a-601",
            "property": "finish"
          },
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "ev-mon-spec",
            "source": "spec-09-91",
            "property": "finish"
          }
        ],
        "@frame": {
          "scope": {
            "@ref": "item",
            "id": "project"
          },
          "cutoff": "2026-06-03T10:00-07:00",
          "perspective": "record",
          "interpretation": null,
          "interpretation_version": null
        },
        "@outcome": "no_change",
        "@party": {
          "@ref": "item",
          "id": "owner"
        }
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "ev-wed-a601",
      "source": "a-601",
      "values": {
        "finish": "brown-paint",
        "@after": {
          "@ref": "assertion",
          "item": "rv-1",
          "context": "rv-1-at",
          "source": "rv-1"
        }
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "story-1+1|story-1+1/d1|story-1+1"
      },
      "expect": {
        "status": "found"
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "story-1|story-1/d2|story-1"
      },
      "expect": {
        "status": "not_found"
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1",
        "frame": {
          "cutoff": "2026-06-04-07:00"
        }
      },
      "expect": {
        "detections": [
          "story-1|story-1/d1|story-1"
        ],
        "standing": {
          "review": "reviewed"
        }
      }
    },
    {
      "op": "read",
      "read": "story",
      "args": {
        "story": "story-1+1",
        "frame": {
          "cutoff": "2026-06-04-07:00"
        }
      },
      "expect": {
        "related": [
          "story-1"
        ],
        "standing": {
          "open": "open",
          "review": "unreviewed"
        }
      }
    },
    {
      "op": "read",
      "read": "pending_review",
      "args": {
        "frame": {
          "cutoff": "2026-06-03T10:00-07:00"
        }
      },
      "expect": {
        "stories": [
          "story-1+1"
        ],
        "count": 1
      }
    }
  ]
}
