{
  "id": "T05_02_reassertion_after_withdrawal_reads_new_value",
  "family": "T05",
  "rules": [
    "6.7.4",
    "6.7.9",
    "5.2.1",
    "5.6.2",
    "9.4.1",
    "12.5"
  ],
  "description": "After the 90 is withdrawn, a later A-601 Assertion of fire_rating 60 reads 60 with its own origin. The withdrawn statement is reinstated only by that new Assertion. The change read reports a withdrawn transition, then a reasserted one.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door",
          "label": "Door 101"
        },
        {
          "id": "a-601",
          "kind": "schedule",
          "label": "Door schedule A-601"
        },
        {
          "id": "a601-0601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "a601-0603",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T09:00-07:00"
            }
          }
        },
        {
          "id": "w1",
          "kind": "withdrawal"
        },
        {
          "id": "w1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-05T09:00-07:00"
            }
          }
        },
        {
          "id": "a601-0610",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-10T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-0601",
      "source": "a-601",
      "values": {
        "fire_rating": 60
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-0603",
      "source": "a-601",
      "values": {
        "fire_rating": 90
      }
    },
    {
      "op": "assert",
      "item": "w1",
      "context": "w1-at",
      "source": "w1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "a601-0603",
            "source": "a-601"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-0610",
      "source": "a-601",
      "values": {
        "fire_rating": 60
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-08T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "fire_rating": {
            "classification": "withdrawn",
            "withdrawn_by": "w1|w1-at|w1",
            "value": "~absent",
            "origin": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-11T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "fire_rating": {
            "classification": "asserted",
            "value": 60,
            "origin": "door-101|a601-0610|a-601",
            "withdrawn_by": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-101",
        "from": {
          "cutoff": "2026-06-04T12:00-07:00"
        },
        "to": {
          "cutoff": "2026-06-08T12:00-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "fire_rating",
            "transition": "withdrawn",
            "prior": "door-101|a601-0603|a-601"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "changes",
      "args": {
        "source": "a-601",
        "subject": "door-101",
        "from": {
          "cutoff": "2026-06-08T12:00-07:00"
        },
        "to": {
          "cutoff": "2026-06-11T12:00-07:00"
        }
      },
      "expect": {
        "transitions": [
          {
            "property": "fire_rating",
            "transition": "reasserted",
            "new": "door-101|a601-0610|a-601"
          }
        ]
      }
    }
  ]
}
