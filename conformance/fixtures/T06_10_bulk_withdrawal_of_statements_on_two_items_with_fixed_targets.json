{
  "id": "T06_10_bulk_withdrawal_of_statements_on_two_items_with_fixed_targets",
  "family": "T06",
  "rules": [
    "6.7.3",
    "6.7.4",
    "9.2.1",
    "12.6"
  ],
  "description": "One withdrawal lists exact targets on Door 101 and Door 102 and ends both. Its target set is fixed: an A-601 Assertion about Door 103 at the same issue, recorded after the withdrawal, is not withdrawn.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door",
          "label": "Door 101"
        },
        {
          "id": "door-102",
          "kind": "door",
          "label": "Door 102"
        },
        {
          "id": "door-103",
          "kind": "door",
          "label": "Door 103"
        },
        {
          "id": "a-601",
          "kind": "schedule",
          "label": "Door schedule A-601"
        },
        {
          "id": "a601-0601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "w1",
          "kind": "withdrawal"
        },
        {
          "id": "w1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-02T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-0601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-102",
      "context": "a601-0601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "w1",
      "context": "w1-at",
      "source": "w1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "a601-0601",
            "source": "a-601"
          },
          {
            "@ref": "assertion",
            "item": "door-102",
            "context": "a601-0601",
            "source": "a-601"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "door-103",
      "context": "a601-0601",
      "source": "a-601",
      "values": {
        "finish": "paint"
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-03T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "withdrawn",
            "withdrawn_by": "w1|w1-at|w1",
            "value": "~absent",
            "origin": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-102",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-03T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "withdrawn",
            "withdrawn_by": "w1|w1-at|w1",
            "value": "~absent",
            "origin": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-103",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-03T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "paint",
            "origin": "door-103|a601-0601|a-601",
            "withdrawn_by": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|a601-0601|a-601"
      },
      "expect": {
        "status": "found",
        "withdrawals": [
          "w1|w1-at|w1"
        ]
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-102|a601-0601|a-601"
      },
      "expect": {
        "status": "found",
        "withdrawals": [
          "w1|w1-at|w1"
        ]
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-103|a601-0601|a-601"
      },
      "expect": {
        "status": "found",
        "withdrawals": []
      }
    }
  ]
}
