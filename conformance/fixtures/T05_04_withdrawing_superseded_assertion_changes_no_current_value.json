{
  "id": "T05_04_withdrawing_superseded_assertion_changes_no_current_value",
  "family": "T05",
  "rules": [
    "6.7.4",
    "5.2.1",
    "5.6.1"
  ],
  "description": "Withdrawing the superseded fire_rating 60 changes nothing: 90 stays current. When the 90 is later withdrawn too, the property reads withdrawn, carrying the withdrawal of the most recent Assertion.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door",
          "label": "Door 101"
        },
        {
          "id": "a-601",
          "kind": "schedule",
          "label": "Door schedule A-601"
        },
        {
          "id": "a601-0601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "a601-0603",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-03T09:00-07:00"
            }
          }
        },
        {
          "id": "w1",
          "kind": "withdrawal"
        },
        {
          "id": "w1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-05T09:00-07:00"
            }
          }
        },
        {
          "id": "w2",
          "kind": "withdrawal"
        },
        {
          "id": "w2-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-08T09:00-07:00"
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-0601",
      "source": "a-601",
      "values": {
        "fire_rating": 60
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "a601-0603",
      "source": "a-601",
      "values": {
        "fire_rating": 90
      }
    },
    {
      "op": "assert",
      "item": "w1",
      "context": "w1-at",
      "source": "w1",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "a601-0601",
            "source": "a-601"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-06T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "fire_rating": {
            "classification": "asserted",
            "value": 90,
            "origin": "door-101|a601-0603|a-601",
            "withdrawn_by": "~absent"
          }
        }
      }
    },
    {
      "op": "assert",
      "item": "w2",
      "context": "w2-at",
      "source": "w2",
      "values": {
        "@action": "withdraw",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-101",
            "context": "a601-0603",
            "source": "a-601"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-06-09T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "fire_rating": {
            "classification": "withdrawn",
            "withdrawn_by": "w2|w2-at|w2",
            "value": "~absent",
            "origin": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "exact",
      "args": {
        "ref": "door-101|a601-0601|a-601"
      },
      "expect": {
        "status": "found",
        "withdrawals": [
          "w1|w1-at|w1"
        ]
      }
    }
  ]
}
