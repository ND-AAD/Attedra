{
  "id": "T16_12_unrelated_scopes_never_compare",
  "family": "T16",
  "rules": [
    "2.1.4",
    "2.1.5",
    "9.1.1",
    "12.1",
    "12.16"
  ],
  "description": "Two projects each have a door marked '101'. Equal labels do not merge them, the two doors are never compared with each other, and each scope's open work holds only its own expectations.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "project-a",
          "kind": "project"
        },
        {
          "id": "project-b",
          "kind": "project"
        },
        {
          "id": "sched-a",
          "kind": "schedule"
        },
        {
          "id": "sched-b",
          "kind": "schedule"
        },
        {
          "id": "door-a101",
          "kind": "door",
          "label": "101"
        },
        {
          "id": "door-b101",
          "kind": "door",
          "label": "101"
        },
        {
          "id": "a-601",
          "kind": "schedule"
        },
        {
          "id": "b-601",
          "kind": "schedule"
        },
        {
          "id": "instr-1",
          "kind": "instruction"
        },
        {
          "id": "a601-issued-0601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "b601-issued-0601",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T09:00-07:00"
            }
          }
        },
        {
          "id": "instr-1-at",
          "kind": "event",
          "definition": {
            "@context": {
              "role": "event",
              "at": "2026-06-01T10:00-07:00"
            }
          }
        },
        {
          "id": "e-req",
          "kind": "expectation-context",
          "definition": {
            "@context": {
              "role": "expectation",
              "timing": {
                "type": "by",
                "instant": "2026-06-27-07:00"
              },
              "fresh": false
            }
          }
        }
      ]
    },
    {
      "op": "connect",
      "from": "project-a",
      "to": "sched-a",
      "at": "2026-05-04T09:00-07:00"
    },
    {
      "op": "connect",
      "from": "sched-a",
      "to": "door-a101",
      "at": "2026-05-04T09:00-07:00"
    },
    {
      "op": "connect",
      "from": "project-b",
      "to": "sched-b",
      "at": "2026-05-04T09:00-07:00"
    },
    {
      "op": "connect",
      "from": "sched-b",
      "to": "door-b101",
      "at": "2026-05-04T09:00-07:00"
    },
    {
      "op": "assert",
      "item": "door-a101",
      "context": "a601-issued-0601",
      "source": "a-601",
      "values": {
        "mark": "101",
        "finish": "paint"
      }
    },
    {
      "op": "assert",
      "item": "door-b101",
      "context": "b601-issued-0601",
      "source": "b-601",
      "values": {
        "mark": "101",
        "finish": "stain"
      }
    },
    {
      "op": "assert",
      "item": "door-a101",
      "context": "e-req",
      "source": "a-601",
      "values": {
        "hardware": "HW-1"
      }
    },
    {
      "op": "assert",
      "item": "door-b101",
      "context": "e-req",
      "source": "b-601",
      "values": {
        "hardware": "HW-2"
      }
    },
    {
      "op": "assert",
      "item": "instr-1",
      "context": "instr-1-at",
      "source": "instr-1",
      "values": {
        "@action": "establish",
        "@targets": [
          {
            "@ref": "assertion",
            "item": "door-a101",
            "context": "e-req",
            "source": "a-601"
          },
          {
            "@ref": "assertion",
            "item": "door-b101",
            "context": "e-req",
            "source": "b-601"
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "conflicts",
      "args": {
        "subject": "door-a101",
        "frame": {
          "scope": "project-a",
          "cutoff": "2026-06-05-07:00"
        }
      },
      "expect": {
        "conflicts": [],
        "expectation_conflicts": []
      }
    },
    {
      "op": "read",
      "read": "resolved_view",
      "args": {
        "subject": "door-a101",
        "frame": {
          "scope": "project-a",
          "cutoff": "2026-06-05-07:00"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "a-601": {
              "classification": "asserted",
              "value": "paint",
              "origin": "door-a101|a601-issued-0601|a-601"
            },
            "b-601": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "open_work",
      "args": {
        "frame": {
          "scope": "project-a",
          "cutoff": "2026-06-05-07:00"
        }
      },
      "expect": {
        "open": [
          {
            "expectation": "door-a101|e-req|a-601",
            "outstanding": [
              "hardware"
            ],
            "not_yet_due": [],
            "withdrawn": [],
            "fulfilled": []
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "open_work",
      "args": {
        "frame": {
          "scope": "project-b",
          "cutoff": "2026-06-05-07:00"
        }
      },
      "expect": {
        "open": [
          {
            "expectation": "door-b101|e-req|b-601",
            "outstanding": [
              "hardware"
            ],
            "not_yet_due": [],
            "withdrawn": [],
            "fulfilled": []
          }
        ]
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "door-a101"
      },
      "expect": {
        "status": "found",
        "label": "101"
      }
    },
    {
      "op": "read",
      "read": "item",
      "args": {
        "id": "door-b101"
      },
      "expect": {
        "status": "found",
        "label": "101"
      }
    }
  ]
}
