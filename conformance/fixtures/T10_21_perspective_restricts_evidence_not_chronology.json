{
  "id": "T10_21_perspective_restricts_evidence_not_chronology",
  "family": "T10",
  "rules": [
    "4.6.1",
    "4.4.2",
    "4.2.4",
    "3.1.2",
    "4.6.3",
    "9.2.2"
  ],
  "description": "A participant listed in the self-description of A-601 at the milestone context, but not in the milestone's publication, is covered for A-601's statement at that milestone: the statement reads asserted in the participant's view and is dated at the publication instant, which is the same in every perspective, and a milestone cutoff resolves to it. The publication Assertion's own values (its edition) are not distributed to that participant and read never_asserted there.",
  "steps": [
    {
      "op": "items",
      "items": [
        {
          "id": "door-101",
          "kind": "door"
        },
        {
          "id": "architect",
          "kind": "party"
        },
        {
          "id": "contractor",
          "kind": "party"
        },
        {
          "id": "consultant",
          "kind": "party"
        },
        {
          "id": "client",
          "kind": "party"
        },
        {
          "id": "arch-schedule",
          "kind": "schedule"
        },
        {
          "id": "arch-log",
          "kind": "issue-log"
        },
        {
          "id": "a-601",
          "kind": "schedule"
        },
        {
          "id": "arch-100dd",
          "kind": "milestone",
          "definition": {
            "@context": {
              "role": "milestone",
              "schedule": {
                "@ref": "item",
                "id": "arch-schedule"
              },
              "stage": "100% DD",
              "ordinal": 300
            }
          }
        }
      ]
    },
    {
      "op": "assert",
      "item": "arch-100dd",
      "context": "arch-100dd",
      "source": "arch-log",
      "values": {
        "@published": "2026-05-13T11:45:12-07:00",
        "@distribution": [
          {
            "@ref": "item",
            "id": "contractor"
          }
        ],
        "edition": "set 4"
      }
    },
    {
      "op": "assert",
      "item": "a-601",
      "context": "arch-100dd",
      "source": "a-601",
      "values": {
        "@producer": {
          "@ref": "item",
          "id": "architect"
        },
        "@distribution": [
          {
            "@ref": "item",
            "id": "consultant"
          }
        ]
      }
    },
    {
      "op": "assert",
      "item": "door-101",
      "context": "arch-100dd",
      "source": "a-601",
      "values": {
        "finish": "stain"
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-05-14T12:00-07:00",
          "perspective": "consultant"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "stain",
            "origin": "door-101|arch-100dd|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "2026-05-13T11:00-07:00",
          "perspective": "consultant"
        }
      },
      "expect": {
        "properties": {
          "finish": {
            "classification": "never_asserted",
            "value": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "door-101",
        "source": "a-601",
        "frame": {
          "cutoff": "arch-100dd",
          "perspective": "consultant"
        }
      },
      "expect": {
        "frame": {
          "cutoff": "2026-05-13T11:45:12-07:00",
          "cutoff_input": "arch-100dd",
          "perspective": "consultant"
        },
        "properties": {
          "finish": {
            "classification": "asserted",
            "value": "stain",
            "origin": "door-101|arch-100dd|a-601"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "arch-100dd",
        "source": "arch-log",
        "frame": {
          "cutoff": "2026-05-14T12:00-07:00",
          "perspective": "consultant"
        }
      },
      "expect": {
        "properties": {
          "edition": {
            "classification": "never_asserted",
            "value": "~absent"
          }
        }
      }
    },
    {
      "op": "read",
      "read": "source_position",
      "args": {
        "subject": "arch-100dd",
        "source": "arch-log",
        "frame": {
          "cutoff": "2026-05-14T12:00-07:00"
        }
      },
      "expect": {
        "properties": {
          "edition": {
            "classification": "asserted",
            "value": "set 4",
            "origin": "arch-100dd|arch-100dd|arch-log"
          }
        }
      }
    }
  ]
}
